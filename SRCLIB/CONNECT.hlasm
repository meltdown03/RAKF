CONNECT  TITLE 'Connect a RAKF UserId to a new group'                   00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       CONNECT                                        * 00000400
*                                                                     * 00000500
*        Author:       Rob Prins                                      * 00000600
*                                                                     * 00000700
*        Attributes:   RENT, REUS.                                    * 00000800
*                                                                     * 00000900
*        Function:     Parse the syntax of the CONNECT command.       * 00001000
*                      Allocate SYS1.SECURE.CNTL(USERS) with IKJDAIR. * 00001100
*                      Read the USERS and place the entries in        * 00001200
*                      table in storage.                              * 00001300
*                                                                     * 00001400
*                      Add a new record type 2 with the new GROUP     * 00001500
*                      of the UserId in the USERS table in storage.   * 00001600
*                                                                     * 00001700
*                      Sort the USERS in the table on alphabetical    * 00001800
*                      order and write the table back in              * 00001900
*                      SYS1.SECURE.CNTL(USERS).                       * 00002000
*                                                                     * 00002100
*                      Free the SYS1.SECURE.CNTL data set.            * 00002200
*                                                                     * 00002300
*        Syntax:       CONNECT UserId GROUP(groupname)                * 00002400
*        Required:     UserId, GROUP                                  * 00002500
*                                                                     * 00002600
*        Return codes: 00 - all good.                                 * 00002700
*                      08 - an error occurred, user is notified       * 00002800
*                           with a message                            * 00002900
*                                                                     * 00003000
*---------------------------------------------------------------------* 00003100
CONNECT  CSECT                                                          00003200
         SAVE  (14,12),,*                                               00003300
         LR    R12,R15                                                  00003400
         USING CONNECT,R12             Base register                    00003500
         LR    R2,R1                   Save parm (CPPL)                 00003600
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00003700
         ST    R1,8(,R13)              Forward pointer                  00003800
         ST    R13,4(,R1)              Backward pointer                 00003900
         LR    R13,R1                  This is our save area            00004000
         USING WORKAREA,R13            Base working storage             00004100
         ST    R2,MYCPPL               Save our CPPL address            00004200
         MVC   RAKFUSER,MDLUSER             ... model DCBs              00004300
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00004400
         XC    DAIR18,DAIR18                        ... blocks          00004500
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00004600
         XC    ADRUSER,ADRUSER         Clear pointer to user table      00004700
         XC    PPL#LA,PPL#LA           Clear pointer to PPL             00004800
         MVC   MSG3,MSG3X              Move message to working storage  00004900
         MVC   MSG4,MSG4X              Move message to working storage  00005000
         MVC   MSG8,MSG8X              Move message to working storage  00005100
         MVC   MSG9,MSG9X              Move message to working storage  00005200
         MVI   SW,0                    Clear flags                      00005300
         LA    R0,DCBABEND             DCB abend exit                   00005400
         ST    R0,EXLST                Save JFCB in exit list           00005500
         MVI   EXLST,X'91'             DCB abend exit is last entry     00005600
         LA    R0,EXLST                Exit list (DCB abend exit)       00005700
         STCM  R0,B'0111',RAKFUSER+DCBEXLSA-IHADCB                      00005800
         GETMAIN RU,LV=104000      GETMAIN room for 1300 user records   00005900
         ST    R1,ADRUSER              Save its address                 00006000
         USING PSA,R0                  Point to CVT                     00006100
         L     R2,PSAANEW              Load ASCB                        00006200
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00006300
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00006400
         BNZ   CONT1                   Yes: found                       00006500
         LA    R1,MSGY                 Msg: 'No ACEE found'             00006600
         LA    R0,L'MSGY               Length                           00006700
         BAL   R14,TPUT                Write the message on screen      00006800
         B     RC08                    End with RC=-08                  00006900
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00007000
         BO    CONT2                                                    00007100
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007200
         LA    R0,L'MSGZ               Length                           00007300
         BAL   R14,TPUT                Write the message on screen      00007400
         B     RC08                    End with RC=-08                  00007500
CONT2    DS    0H                                                       00007600
*---------------------------------------------------------------------* 00007700
*        Parse parameters                                             * 00007800
*---------------------------------------------------------------------* 00007900
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00008000
         STM   R0,R1,PPL#LA            Save length and address of PPL   00008100
         L     R2,PPL#PTR              Get the address of the PPL       00008200
         USING PPL,R2                  Adress it                        00008300
         L     R1,MYCPPL               Get address of CPPL              00008400
         USING CPPL,R1                 Address it                       00008500
*---------------------------------------------------------------------* 00008600
*                                                                       00008700
*        Populate the Parse Parameter List (PPL) from the CPPL,         00008800
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00008900
*                                                                       00009000
*---------------------------------------------------------------------* 00009100
*                                                                       00009200
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00009300
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00009400
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00009500
*                                      From the CPPL                    00009600
         XC    ECB,ECB                 Clear Event control block        00009700
         L     R1,=A(ADDPCL)           Address of PCL                   00009800
         ST    R1,PPLPCL               Set in PPL                       00009900
         LA    R1,ANSWER               Answer area                      00010000
         ST    R1,PPLANS               Pointer into PPL                 00010100
         LA    R1,ECB                  Event control block              00010200
         ST    R1,PPLECB               Pointer into PPL                 00010300
         ST    R13,PPLUWA              User provide workarea            00010400
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00010500
         DROP  R1,R2                   CPPL and PPL                     00010600
         LTR   R15,R15                 Parse successfully processed?    00010700
         BZ    PARSEOK                 Yes: carry                       00010800
         LA    R0,L'MSG5               Length                           00010900
         LA    R1,MSG5                 Message                          00011000
         BAL   R14,TPUT                                                 00011100
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00011200
         B     RC08                    Return to TMP                    00011300
PARSEOK  DS    0H                                                       00011400
         L     R8,ANSWER               Pointer to PDL                   00011500
         USING ADDPRS,R8               mapped with IKJPARM              00011600
         LA    R3,GROUPPDE             Point to Group PDE               00011700
         USING GRPRET,R3               Get addressability of GROUPPDE   00011800
         MVC   GROUP,=CL8' '           Initialize Group                 00011900
         TM    GRPFLG,$GPRES           Group present?                   00012000
         BO    GRP001                  Yes: good                        00012100
         LA    R1,MSG0                 Msg: Group not specified         00012200
         LA    R0,L'MSG0               Length                           00012300
         BAL   R14,TPUT                Inform user                      00012400
         B     RC08                    Return                           00012500
GRP001   L     R1,GRPPTR               Point to GROUP 1                 00012600
         LH    R2,GRPL                 Length of GROUP                  00012700
         BCTR  R2,0                    -1 for EX                        00012800
         EX    R2,MVEGRP                                                00012900
         B     ENDGRP                  Jump over EX                     00013000
MVEGRP   MVC   GROUP(0),0(R1)          << Executed >>                   00013100
ENDGRP   DS    0H                                                       00013200
         DROP  R3                      Unbase GRPRET                    00013300
         MVC   USERID,=CL8' '          Initialize UserId                00013400
         LA    R3,UIDPDE               UserID PDE                       00013500
         USING UIDRET,R3               Base this PDE                    00013600
         L     R1,UIDPTR               Pointer to UserID                00013700
         LH    R2,UIDL                 Length                           00013800
         BCTR  R2,0                    -1 for EX                        00013900
         EX    R2,MVEUID               Move UserID                      00014000
         B     ENDPARS                 Branch over EX                   00014100
MVEUID   MVC   USERID(0),0(R1)         << Executed >>                   00014200
ENDPARS  DS    0H                                                       00014300
         DROP  R3                      Unbase UIDRET                    00014400
*---------------------------------------------------------------------* 00014500
*        Allocate SYS1.SECURE.CNTL(USERS)                             * 00014600
*---------------------------------------------------------------------* 00014700
         LA    R3,DAIR08               Allocation request block         00014800
         USING DAPB08,R3               Base DAPB08                      00014900
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00015000
         MVC   DA08DDN,=CL8'RAKFUSER'  DDNAME to allocate               00015100
         MVC   DA08PDSN,=A(USRDSNL)    Temporary data set name          00015200
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00015300
         MVC   DA08MNM,=CL8'USERS'     Fixed member name                00015400
         MVI   DA08UNIT,C' '           Clear unit name                  00015500
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00015600
         MVI   DA08SER,C' '            Clear volume serial              00015700
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00015800
         LR    R1,R3                   Parameter CALLTS                 00015900
         BAL   R14,CALLTS              IKJDAIR routine                  00016000
         LTR   R15,R15                 Allocation OK?                   00016100
         BZ    CONN001                 Yes: carry on                    00016200
         LA    R1,MSG1                 Msg: 'allocation error USER'     00016300
         LA    R0,L'MSG1               Length                           00016400
         BAL   R14,TPUT                Write the message on screen      00016500
         B     RC08                    Return code 8                    00016600
CONN001  DS    0H                                                       00016700
*---------------------------------------------------------------------* 00016800
*        Open SYS1.SECURE.CNTL(USERS) with DDNAME RAKUSER             * 00016900
*---------------------------------------------------------------------* 00017000
         MVI   OPEND,X'80'             First and only DCB               00017100
         OPEN  RAKFUSER,MF=(E,OPEND)                                    00017200
         TM    SW,$913                 Access denied?                   00017300
         BNO   CONN003                 No: assumed, that open is succes 00017400
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00017500
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00017600
         LA    R0,L'MSG3               Length                           00017700
         BAL   R14,TPUT                Write the message on screen      00017800
         BAL   R14,FREE                Free the data sets               00017900
         B     RC08                    Return code 8                    00018000
CONN003  DS    0H                                                       00018100
*---------------------------------------------------------------------* 00018200
*        Read the USERS records and check if UserID is already        * 00018300
*        added.                                                       * 00018400
*        And populate the table with User records.                    * 00018500
*---------------------------------------------------------------------* 00018600
         XR    R5,R5                   Clear record counter             00018700
         XR    R3,R3                   Clear users counter              00018800
         LA    R7,RECAREA              Record area                      00018900
         L     R6,ADRUSER              Start of user table              00019000
CONN009  DS    0H                                                       00019100
         GET   RAKFUSER                Read a record                    00019200
         CLI   0(R1),C'*'              Comment record?                  00019300
         BE    CONN009                 Skip the record                  00019400
         USING USERREC,R1              Base Userrec                     00019500
         LA    R5,1(,R5)               Count record                     00019600
         C     R5,=F'1295'             Already 1295 records in table?   00019700
         BL    CONN010                 No: room enough                  00019800
         LA    R1,MSG7                 Msg: 'table full'                00019900
         LA    R0,L'MSG7               Length                           00020000
         BAL   R14,TPUT                Write the message on screen      00020100
         BAL   R14,CLOSE               Close RAKFUSER                   00020200
         BAL   R14,FREE                Free the data sets               00020300
         B     RC08                    Return code 8                    00020400
CONN010  MVC   0(80,R6),USERREC        Record into table                00020500
         LA    R6,80(,R6)              Next entry in table              00020600
         CLC   USERUID,USERID          Match found of UserID?           00020700
         BNE   CONN009                 No: good                         00020800
         C     R3,=F'5'                Already 5 records in RECAREA?    00020900
         BNL   CONN011                 Yes: error                       00021000
         MVI   0(R7),C' '              Blank record in RECAREA entry    00021100
         MVC   1(79,R7),0(R7)                                           00021200
         MVC   0(17,R7),0(R1)          Move specified USER + GROUP      00021300
         MVI   8(R7),C'2'              Record type 2: connected group   00021400
         LA    R3,1(,R3)               Count                            00021500
         LA    R7,80(,R7)              Next entry in RECAREA            00021600
         B     CONN009                 Read next record                 00021700
CONN011  LA    R1,MSG2                 Msg: 'Max groups reached'        00021800
         LA    R0,L'MSG2               Length                           00021900
         BAL   R14,TPUT                Write the message on screen      00022000
         BAL   R14,CLOSE               Close the DCBs                   00022100
         BAL   R14,FREE                Free the data sets               00022200
         B     RC08                    Return code 8                    00022300
USEREOF  DS    0H                      EOF RACFUSER                     00022400
         BAL   R14,CLOSE               Close RAKFUSER                   00022500
*---------------------------------------------------------------------* 00022600
*        Obtain the USERS records from RECAREA and check if           * 00022700
*        the user is already connected to the group.                  * 00022800
*        If not: add an extra USERS record with the speicified group. * 00022900
*---------------------------------------------------------------------* 00023000
         LTR   R3,R3                   Are there records in this area?  00023100
         BZ    CONN014                 No: notify error                 00023200
         DROP  R1                      Unbase                           00023300
         LA    R7,RECAREA              Area with max 6 records          00023400
         USING USERREC,R7              Base USERREC in RECAREA          00023500
CONN012  CLC   USERGRP,GROUP           Already connected?               00023600
         BE    CONN013                 Yes: error                       00023700
         LA    R7,80(,R7)              Next entry in RECAREA            00023800
         BCT   R3,CONN012              Test next entry                  00023900
*        LA    R6,80(,R6)              Next entry in USERS table        00024000
         LA    R7,RECAREA              Point to max 6 USERS records     00024100
         MVI   USERDFT,C' '            New group is not DFLTGRP         00024200
         MVC   USERGRP,GROUP           Move new Group                   00024300
         MVC   0(80,R6),0(R7)          Move entry RECAREA to table      00024400
         LA    R5,1(,R5)               Count record                     00024500
         B     CONN016                 Branch                           00024600
         DROP  R7                      Kill addressability USERREC      00024700
CONN013  MVC   MSG8+14(8),USERID       UserId into message              00024800
         MVC   MSG8+50(8),GROUP        GROUP into message               00024900
         LA    R1,MSG8                 Msg: 'User already connected'    00025000
         LA    R0,L'MSG8               Length                           00025100
         BAL   R14,TPUT                Write the message on screen      00025200
         BAL   R14,CLOSE               Close the DCBs                   00025300
         BAL   R14,FREE                Free the data sets               00025400
         B     RC08                    Return code 8                    00025500
CONN014  MVC   MSG4+14(8),USERID       UserId into message              00025600
         LA    R1,MSG4                 Msg: 'User not found'            00025700
         LA    R0,L'MSG4               Length                           00025800
         BAL   R14,TPUT                Write the message on screen      00025900
         BAL   R14,CLOSE               Close the DCBs                   00026000
         BAL   R14,FREE                Free the data sets               00026100
         B     RC08                    Return code 8                    00026200
CONN016  MVI   OPEND,X'80'             First and only DCB               00026300
         OPEN  (RAKFUSER,(OUTPUT)),MF=(E,OPEND)                         00026400
         TM    SW,$913                 Access denied?                   00026500
         BNO   CONN019                 No: assumed, that open is succes 00026600
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00026700
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00026800
         LA    R0,L'MSG3               Length                           00026900
         BAL   R14,TPUT                Write the message on screen      00027000
         BAL   R14,CLOSE               Close the DCBs                   00027100
         BAL   R14,FREE                Free the data sets               00027200
         B     RC08                    Return code 8                    00027300
*---------------------------------------------------------------------* 00027400
*        Sort the USERS records alphabetically and    .               * 00027500
*        write the RAKF Users back in the USERS member.               * 00027600
*---------------------------------------------------------------------* 00027700
CONN019  DS    0H                                                       00027800
SORT     STM   R4,R8,SAVESORT                                           00027900
         LR    R7,R5                   Copy record counter              00028000
         L     R2,ADRUSER              Point to first entry in table    00028100
         CH    R7,=H'2'                Less than 2 records?             00028200
         BL    ENDSORT                 Do not sort                      00028300
         BCTR  R7,0                    Minus 1                          00028400
         MH    R7,=H'80'               ** Record length                 00028500
         LA    R7,0(R2,R7)             Point to last record             00028600
*                                                                       00028700
SORT01   DS    0H                      Start sort                       00028800
         ST    R7,SWAPLAST             Last record swapped              00028900
         L     R4,ADRUSER              Point to first entry in table    00029000
         LR    R5,R4                   Next                             00029100
         LA    R5,80(,R4)                   Record                      00029200
SORT03   DS    0H                                                       00029300
         CL    R4,SWAPLAST             Last record reached?             00029400
         BNL   SORT07                  Yes: loop complete               00029500
         CLC   0(72,R4),0(R5)          Compare (skip sequence numbers)  00029600
         BNH   SORT05                  High: swap these records         00029700
         XC    0(80,R4),0(R5)          Swap                             00029800
         XC    0(80,R5),0(R4)              the                          00029900
         XC    0(80,R4),0(R5)                   records                 00030000
         LR    R7,R4                   Last record swapped in R7        00030100
SORT05   DS    0H                      Load next entry                  00030200
         LA    R4,80(,R4)              Next recodd                      00030300
         LA    R5,80(,R5)              Next record                      00030400
         B     SORT03                  Compare next record              00030500
SORT07   DS    0H                      All records done                 00030600
         CL    R7,SWAPLAST             Are these swaps executed?        00030700
         BL    SORT01                  No: sort them again              00030800
*                                      Else end of sort                 00030900
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00031000
         L     R6,ADRUSER              Max 1300 user entries            00031100
CONN021  PUT   RAKFUSER,0(R6)          Write ...                        00031200
         LA    R6,80(,R6)                    User ...                   00031300
         BCT   R5,CONN021                         table back            00031400
         MVC   MSG9+14(8),USERID       UserID in success message        00031500
         MVC   MSG9+42(8),GROUP        GROUP in success message         00031600
         LA    R1,MSG9                 Success message                  00031700
         LA    R0,L'MSG9               Length                           00031800
         BAL   R14,TPUT                Write the message on screen      00031900
         LA    R1,MSGA                 Msg: Run RAKFUSER ...            00032000
         LA    R0,L'MSGA               Length                           00032100
         BAL   R14,TPUT                Write the message on screen      00032200
         BAL   R14,CLOSE               Close the data sets              00032300
         BAL   R14,FREE                And unallocate                   00032400
         LA    R15,0                   RC = 0                           00032500
         B     RETURN                                                   00032600
*---------------------------------------------------------------------* 00032700
*        Return to TSO TMP.                                           * 00032800
*---------------------------------------------------------------------* 00032900
RC08     DS    0H                                                       00033000
         LA    R15,8                   RC = 8                           00033100
RETURN   DS    0H                                                       00033200
         LR    R4,R15                  Save return code                 00033300
         ICM   R2,15,PPL#LA            Filled in?                       00033400
         BZ    RETURN1                 No: do not free                  00033500
         LM    R2,R3,PPL#LA            Load length and address of PPL   00033600
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00033700
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00033800
         BZ    RETURN2                 No: skip                         00033900
         IKJRLSA (R8)                  Release PARSE storage            00034000
RETURN2  L     R2,ADRUSER              Point to USER core table         00034100
         FREEMAIN RU,LV=104000,A=(2)                                    00034200
         LR    R3,R13                  Load working storage to free     00034300
         L     R13,4(,R13)             Load caller's save area          00034400
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00034500
         LR    R15,R4                  Restore return code              00034600
         RETURN (14,12),RC=(15)        Return                           00034700
*                                                                       00034800
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00034900
*---------------------------------------------------------------------* 00035000
*        Routine:   CALLTS                                            * 00035100
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00035200
*                   Register 1 contains the address of the allocation * 00035300
*                   or unallocation DAIR parameter blocks.            * 00035400
*---------------------------------------------------------------------* 00035500
CALLTS   DS    0H                                                       00035600
         ST    R14,R14TS               Save register 14                 00035700
         LR    R14,R1                  Save A(IKJDAIR parm block)       00035800
         XC    ECB,ECB                 Clear ECB                        00035900
         LA    R1,DAIRDAPL                                              00036000
         L     R2,MYCPPL               Pickup our CPPL                  00036100
         USING CPPL,R2                 Base CPPL                        00036200
         USING DAPL,R1                 Base IKJDAPL                     00036300
         MVC   DAPLUPT(4),CPPLUPT                                       00036400
         MVC   DAPLECT(4),CPPLECT                                       00036500
         XC    ECB,ECB                 Clear Event control block        00036600
         LA    R0,ECB                  Address of our ECB               00036700
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00036800
         MVC   DAPLPSCB(4),CPPLPSCB                                     00036900
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00037000
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00037100
         L     R14,R14TS               Restore register 14              00037200
         BR    R14                                                      00037300
         DROP  R1,R2                   Unbase DAPL and CPPL             00037400
         TITLE 'Write message on screen'                                00037500
*---------------------------------------------------------------------* 00037600
*        Write the message on the terminal with a PUTLINE.            * 00037700
*        Register 0 = the length of the message.                      * 00037800
*        Register 1 = adress of the message.                          * 00037900
*---------------------------------------------------------------------* 00038000
TPUT     DS    0H                                                       00038100
         ST    R14,R14TPUT             Save register 14                 00038200
         L     R3,MYCPPL               Pickup CPPL of this command      00038300
         USING CPPL,R3                 Base IKJCPPL                     00038400
         MVI   PUTLINE+4,C' '          Clear output line                00038500
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00038600
         LR    R2,R0                   Length of message                00038700
         BCTR  R2,0                    Minus 1 for EX                   00038800
         EX    R2,MVEMSG               Move the message                 00038900
         LA    R2,5(,R2)               Length in including length field 00039000
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00039100
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00039200
         L     R2,CPPLUPT              User Profile Table               00039300
         L     R3,CPPLECT              Environment Control Table        00039400
         XC    ECB,ECB                 Force PUTLINE to wait            00039500
         LA    R0,PUTLINE              Data line address                00039600
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00039700
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00039800
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00039900
         L     R14,R14TPUT             Restore register 14              00040000
         BR    R14                                                      00040100
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00040200
         DROP  R3                      Unbase CPPL                      00040300
         TITLE 'Free SYS1.SECURE.CNTL'                                  00040400
FREE     DS    0H                                                       00040500
         ST    R14,R14FREE             Save register 14                 00040600
         LA    R3,DAIR18               Point to unallocation parm block 00040700
         XC    DAIR18,DAIR18           Clear unallocation parm block    00040800
         USING DAPB18,R3               IKJDAP18                         00040900
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00041000
         MVI   DA18MNM,C' '            Provide no ...                   00041100
         MVC   DA18MNM+1(7),DA18MNM               member name           00041200
         MVC   DA18DDN,=CL8'RAKFUSER'  DDNAME to unallocate             00041300
         LR    R1,R3                   Parameter CALLTS                 00041400
         BAL   R14,CALLTS              IKJDAIR routine                  00041500
         L     R14,R14FREE             Restore register 14              00041600
         BR    R14                     Return                           00041700
         DROP  R3                      Unbase DAPB18                    00041800
         TITLE 'Close RAKFUSER'                                         00041900
CLOSE    ST    R14,R14CLOSE            Save register 14                 00042000
         MVI   CLOSED,X'80'            First and only DCB               00042100
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00042200
         L     R14,R14CLOSE            Restore register 14              00042300
         BR    R14                     Return                           00042400
         TITLE 'DCB abend exit'                                         00042500
DCBABEND DS    0H                                                       00042600
         TM    3(R1),B'00001110'       Processing allowed?              00042700
         BZR   R14                     No: continue with abend          00042800
         TM    3(R1),4                 Ignore bit on?                   00042900
         MVI   3(R1),0                 Prepare for NO                   00043000
         BZR   R14                                                      00043100
         MVC   DCBCOMP,0(R1)           Move completion code             00043200
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00043300
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00043400
         BNER  R14                     No: continue with abend          00043500
         MVI   3(R1),4                 Yes: ignore abend                00043600
         OI    SW,$913                 Indicate 913 abend               00043700
         BR    R14                     Return to Access Method          00043800
