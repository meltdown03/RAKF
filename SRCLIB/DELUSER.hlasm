DELUSER  TITLE 'Deleta RAKF users from the control data sets'           00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       DELUSER                                        * 00000400
*                                                                     * 00000500
*        Author:       Rob Prins                                      * 00000600
*                                                                     * 00000700
*        Attributes:   RENT, REUS.                                    * 00000800
*                                                                     * 00000900
*        Function:     Parse the syntax of the DELUSER command.       * 00001000
*                      Allocate SYS1.SECURE.CNTL(USERS)               * 00001100
*                      dynamically with IKJDAIR.                      * 00001200
*                                                                     * 00001300
*                      Read the USERS table into storage,             * 00001400
*                      delete the user and write the table back.      * 00001500
*                                                                     * 00001600
*                      If GROUP is specified delete only the record   * 00001700
*                      with that GROUP (disconnect), unless it's      * 00001800
*                      the default group (DFLTGRP) or the GROUP in    * 00001900
*                      USERS record type 1 (with the password).       * 00002000
*                                                                     * 00002100
*                      Free the SYS1.SECURE.CNTL data set.            * 00002200
*                                                                     * 00002300
*        Syntax:       DELUSER userid (GROUP(groupname))              * 00002400
*                                                                     * 00002500
*        Return codes: 00 - all good.                                 * 00002600
*                      08 - an error occurred, user is notified       * 00002700
*                           with a message                            * 00002800
*                                                                     * 00002900
*---------------------------------------------------------------------* 00003000
DELUSER  CSECT                                                          00003100
         SAVE  (14,12),,*                                               00003200
         LR    R12,R15                                                  00003300
         USING DELUSER,R12             Base register                    00003400
         LR    R2,R1                   Save parm (CPPL)                 00003500
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00003600
         ST    R1,8(,R13)              Forward pointer                  00003700
         ST    R13,4(,R1)              Backward pointer                 00003800
         LR    R13,R1                  This is our save area            00003900
         USING WORKAREA,R13            Base working storage             00004000
         ST    R2,MYCPPL               Save our CPPL address            00004100
START    DS    0H                                                       00004200
         MVC   RAKFUSER,MDLUSER             ... model DCBs              00004300
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00004400
         XC    DAIR18,DAIR18                        ... blocks          00004500
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00004600
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00004700
         MVC   MSG3,MSG3X              Move message to working storage  00004800
         MVC   MSG6,MSG6X              Move message to working storage  00004900
         MVC   MSGB,MSGBX              Move message to working storage  00005000
         MVI   SW,0                    Clear flags                      00005100
         LA    R0,DCBABEND             DCB abend exit                   00005200
         ST    R0,EXLST                Save JFCB in exit list           00005300
         MVI   EXLST,X'91'             DCB abend exit is last entry     00005400
         LA    R0,EXLST                Exit list (DCB abend exit)       00005500
         STCM  R0,B'0111',RAKFUSER+DCBEXLSA-IHADCB                      00005600
         GETMAIN RU,LV=104000      GETMAIN room for 1300 user records   00005700
         ST    R1,ADRUSER              Save its address                 00005800
         USING PSA,R0                  Point to CVT                     00005900
         L     R2,PSAANEW              Load ASCB                        00006000
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00006100
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00006200
         BNZ   CONT1                   Yes: found                       00006300
         LA    R1,MSGY                 Msg: 'No ACEE found'             00006400
         LA    R0,L'MSGY               Length                           00006500
         BAL   R14,TPUT                Write the message on screen      00006600
         B     RC08                    End with RC=-08                  00006700
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00006800
         BO    CONT2                                                    00006900
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007000
         LA    R0,L'MSGZ               Length                           00007100
         BAL   R14,TPUT                Write the message on screen      00007200
         B     RC08                    End with RC=-08                  00007300
CONT2    DS    0H                                                       00007400
*---------------------------------------------------------------------* 00007500
*        Parse parameters                                             * 00007600
*---------------------------------------------------------------------* 00007700
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00007800
         STM   R0,R1,PPL#LA            Save length and address of PPL   00007900
         L     R2,PPL#PTR              Get the address of the PPL       00008000
         USING PPL,R2                  Adress it                        00008100
         L     R1,MYCPPL               Get address of CPPL              00008200
         USING CPPL,R1                 Address it                       00008300
*---------------------------------------------------------------------* 00008400
*        Populate the Parse Parameter List (PPL) from the CPPL,         00008500
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00008600
*---------------------------------------------------------------------* 00008700
*                                                                       00008800
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00008900
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00009000
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00009100
*                                      From the CPPL                    00009200
         XC    ECB,ECB                 Clear Event control block        00009300
         L     R1,=A(ADDPCL)           Address of PCL                   00009400
         ST    R1,PPLPCL               Set in PPL                       00009500
         LA    R1,ANSWER               Answer area                      00009600
         ST    R1,PPLANS               Pointer into PPL                 00009700
         LA    R1,ECB                  Event control block              00009800
         ST    R1,PPLECB               Pointer into PPL                 00009900
         ST    R13,PPLUWA              User provide workarea            00010000
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00010100
         DROP  R1,R2                   CPPL and PPL                     00010200
         LTR   R15,R15                 Parse successfully processed?    00010300
         BZ    PARSEOK                 Yes: carry                       00010400
         LA    R0,L'MSG5               Length                           00010500
         LA    R1,MSG5                 Msg: Parse error                 00010600
         BAL   R14,TPUT                                                 00010700
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00010800
         B     RC08                    Return to TMP                    00010900
PARSEOK  DS    0H                                                       00011000
         L     R8,ANSWER               Pointer to PDL                   00011100
         USING ADDPRS,R8               mapped with IKJPARM              00011200
         LA    R3,GROUPPDE             Point to Group PDE               00011300
         USING GRPRET,R3               Get addressability of GROUPPDE   00011400
         MVC   GROUP,=CL8' '           Initialize Group                 00011500
         TM    GRPFLG,$GPRES           Group present?                   00011600
         BO    GRP001                  No: all records of Userid delete 00011700
         OI    SW,$ALL                 Mark it                          00011800
         B     ENDGRP                  Ready                            00011900
GRP001   L     R1,GRPPTR               Point to GROUP 1                 00012000
         LH    R2,GRPL                 Length of GROUP                  00012100
         BCTR  R2,0                    -1 for EX                        00012200
         EX    R2,MVEGRP                                                00012300
         B     ENDGRP                  Jump over EX                     00012400
MVEGRP   MVC   GROUP(0),0(R1)          << Executed >>                   00012500
ENDGRP   DS    0H                                                       00012600
         DROP  R3                      Unbase GRPRET                    00012700
         MVC   USERID,=CL8' '          Initialize UserId                00012800
         LA    R3,UIDPDE               UserID PDE                       00012900
         USING UIDRET,R3               Base this PDE                    00013000
         L     R1,UIDPTR               Pointer to UserID                00013100
         LH    R2,UIDL                 Length                           00013200
         BCTR  R2,0                    -1 for EX                        00013300
         EX    R2,MVEUID               Move UserID                      00013400
         B     ENDPARS                 Branch over EX                   00013500
MVEUID   MVC   USERID(0),0(R1)         << Executed >>                   00013600
ENDPARS  DS    0H                                                       00013700
*---------------------------------------------------------------------* 00013800
*        Allocate SYS1.SECURE.CNTL(USERS)                             * 00013900
*---------------------------------------------------------------------* 00014000
         LA    R3,DAIR08               Allocation request block         00014100
         USING DAPB08,R3               Base DAPB08                      00014200
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00014300
         MVC   DA08DDN,=CL8'RAKFUSER'  DDNAME to allocate               00014400
         MVC   DA08PDSN,=A(USRDSNL)    Temporary data set name          00014500
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00014600
         MVC   DA08MNM,=CL8'USERS'     Fixed member name                00014700
         MVI   DA08UNIT,C' '           Clear unit name                  00014800
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00014900
         MVI   DA08SER,C' '            Clear volume serial              00015000
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00015100
         LR    R1,R3                   Parameter CALLTS                 00015200
         BAL   R14,CALLTS              IKJDAIR routine                  00015300
         LTR   R15,R15                 Allocation OK?                   00015400
         BZ    DELU003                 Yes: carry on                    00015500
         LA    R1,MSG1                 Msg: 'allocation error USER'     00015600
         LA    R0,L'MSG1               Length                           00015700
         BAL   R14,TPUT                Write the message on screen      00015800
         B     RC08                    Return code 8                    00015900
         DROP  R3                      Unbase DABP08                    00016000
DELU003  DS    0H                                                       00016100
*---------------------------------------------------------------------* 00016200
*        Open SYS1.SECURE.CNTL(USERS) with DDNAME RAKUSER             * 00016300
*---------------------------------------------------------------------* 00016400
         MVI   OPEND,X'80'             First and only DCB               00016500
         OPEN  RAKFUSER,MF=(E,OPEND)                                    00016600
         TM    SW,$913                 Access denied?                   00016700
         BNO   DELU007                 No: assumed, that open is succes 00016800
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00016900
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00017000
         LA    R0,L'MSG3               Length                           00017100
         BAL   R14,TPUT                Write the message on screen      00017200
         BAL   R14,FREE                Free the data sets               00017300
         B     RC08                    Return code 8                    00017400
DELU007  DS    0H                                                       00017500
*---------------------------------------------------------------------* 00017600
*        Read the USERS records and check if UserID is present        * 00017700
*        And populate the table with User records except the to       * 00017800
*        be deleted user.                                             * 00017900
*---------------------------------------------------------------------* 00018000
         XR    R5,R5                   Clear record counter             00018100
         L     R6,ADRUSER              Start of user table              00018200
DELU009  DS    0H                                                       00018300
         GET   RAKFUSER,USERREC        Read a record                    00018400
         CLC   USERUID,USERID          Match found of UserID?           00018500
         BE    DELU015                 Yes: place not in table          00018600
DELU011  MVC   0(80,R6),USERREC        Record into table                00018700
         LA    R6,80(,R6)              Next entry in table              00018800
         LA    R5,1(,R5)               Count record                     00018900
         C     R5,=F'1300'             Already 1300 records in table?   00019000
         BL    DELU009                 No: room enough                  00019100
         LA    R1,MSG7                 Msg: 'table full'                00019200
         LA    R0,L'MSG7               Length                           00019300
         BAL   R14,TPUT                Write the message on screen      00019400
         BAL   R14,CLOSE               Close RAKFUSER                   00019500
         BAL   R14,FREE                Free the data sets               00019600
         B     RC08                    Return code 8                    00019700
DELU015  TM    SW,$ALL                 All occurences deleted?          00019800
         BO    DELU025                 No: skip (delete) record         00019900
DELU021  CLC   USERGRP,GROUP           Does the GROUP match             00020000
         BNE   DELU011                 No: put in table                 00020100
         CLI   USER#,C'1'              Is it the password record?       00020200
         BE    DELU027                Yes: notify user                  00020300
         CLI   USERDFT,C'*'            Default group?                   00020400
         BE    DELU029                Yes: notify user                  00020500
DELU025  OI    SW,$DELU                Flag deleted from USERS          00020600
         B     DELU009                 Skip record                      00020700
DELU027  LA    R1,MSG2              Msg: PASSWORD record cannot deleted 00020800
         LA    R0,L'MSG2               Length                           00020900
         BAL   R14,TPUT                Write the message on screen      00021000
         BAL   R14,CLOSE               Close RAKFUSER                   00021100
         BAL   R14,FREE                Free the data sets               00021200
         B     RC08                    Return code 8                    00021300
DELU029  LA    R1,MSG0                 Msg: DFLTGRP cannot be deleted   00021400
         LA    R0,L'MSG0               Length                           00021500
         BAL   R14,TPUT                Write the message on screen      00021600
         BAL   R14,CLOSE               Close RAKFUSER                   00021700
         BAL   R14,FREE                Free the data sets               00021800
         B     RC08                    Return code 8                    00021900
USEREOF  DS    0H                      EOF RACFUSER                     00022000
         TM    SW,$DELU                It a user deleted from USERS?    00022100
         BZ    DELU033                 No: no sense to write table back 00022200
         L     R6,ADRUSER              Point to start of table          00022300
         MVI   CLOSED,X'80'            First and only DCB               00022400
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00022500
         MVI   OPEND,X'80'             First and only DCB               00022600
         OPEN  (RAKFUSER,(OUTPUT)),MF=(E,OPEND)                         00022700
         TM    SW,$913                 Access denied?                   00022800
         BNO   DELU031                 No: assumed, that open is succes 00022900
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00023000
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00023100
         LA    R0,L'MSG3               Length                           00023200
         BAL   R14,TPUT                Write the message on screen      00023300
         BAL   R14,CLOSE               Close RAKFUSER                   00023400
         BAL   R14,FREE                Free the data sets               00023500
         B     RC08                    Return code 8                    00023600
DELU031  PUT   RAKFUSER,0(R6)          Write record back in USERS       00023700
         LA    R6,80(,R6)              Next user entry in table         00023800
         BCT   R5,DELU031              And write all entries back       00023900
*---------------------------------------------------------------------* 00024000
*        Close USERS and and return to TMP.                           * 00024100
*---------------------------------------------------------------------* 00024200
DELU033  DS    0H                                                       00024300
         BAL   R14,CLOSE               Close the data sets              00024400
         BAL   R14,FREE                And unallocate                   00024500
         LA    R15,0                   RC = 0                           00024600
         B     RETURN                                                   00024700
*---------------------------------------------------------------------* 00024800
*        Return to TSO TMP.                                           * 00024900
*---------------------------------------------------------------------* 00025000
RC08     DS    0H                                                       00025100
         LA    R15,8                   RC = 8                           00025200
RETURN   DS    0H                                                       00025300
         LR    R4,R15                  Save return code                 00025400
         ICM   R2,15,PPL#LA            Is PPL allocated?                00025500
         BZ    RETURN1                 No: do not free                  00025600
         LM    R2,R3,PPL#LA            Address + Length PPL             00025700
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00025800
RETURN1  L     R2,ADRUSER              Address of user table            00025900
         FREEMAIN RU,LV=104000,A=(2)                                    00026000
         TM    SW,$DELU                Anything deleted?                00026100
         BNZ   RETURN2                 Yes: carry on                    00026200
         LA    R1,MSG4                 Msg: 'nothing deleted'           00026300
         LA    R0,L'MSG4               Length                           00026400
         BAL   R14,TPUT                Write message on screen          00026500
         B     RETURN8                 And branch                       00026600
RETURN2  DS    0H                                                       00026700
         TM    SW,$ALL                 All occurences deleted?          00026800
         BO    RETURN3                 Yes: good                        00026900
         MVC   MSGB+14(8),USERID       UserId in message                00027000
         MVC   MSGB+47(8),GROUP        Group in message                 00027100
         LA    R1,MSGB                 Msg: 'disconnected from ...'     00027200
         LA    R0,L'MSGB               Length                           00027300
         B     RETURN4                 Inform user                      00027400
RETURN3  MVC   MSG6+14(8),USERID       UserId in message                00027500
         LA    R1,MSG6                 Msg: 'successfully deleted'      00027600
         LA    R0,L'MSG6               Length                           00027700
RETURN4  BAL   R14,TPUT                Write message on screen          00027800
         LA    R1,MSGA                 Msg: 'run RAKFUSER ...'          00027900
         LA    R0,L'MSGA               Length                           00028000
         BAL   R14,TPUT                Write message on screen          00028100
RETURN8  DS    0H                                                       00028200
         ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00028300
         BZ    RETURN9                 No: skip                         00028400
         IKJRLSA (R8)                  Release PARSE storage            00028500
RETURN9  LR    R3,R13                  Load working storage to free     00028600
         L     R13,4(,R13)             Load caller's save area          00028700
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00028800
         LR    R15,R4                  Restore return code              00028900
         RETURN (14,12),RC=(15)        Return                           00029000
*                                                                       00029100
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00029200
*---------------------------------------------------------------------* 00029300
*        Routine:   CALLTS                                            * 00029400
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00029500
*                   Register 1 contains the address of the allocation * 00029600
*                   or unallocation DAIR parameter blocks.            * 00029700
*---------------------------------------------------------------------* 00029800
CALLTS   DS    0H                                                       00029900
         ST    R14,R14TS               Save register 14                 00030000
         LR    R14,R1                  Save A(IKJDAIR parm block)       00030100
         XC    ECB,ECB                 Clear ECB                        00030200
         LA    R1,DAIRDAPL                                              00030300
         L     R2,MYCPPL               Pickup our CPPL                  00030400
         USING CPPL,R2                 Base CPPL                        00030500
         USING DAPL,R1                 Base IKJDAPL                     00030600
         MVC   DAPLUPT(4),CPPLUPT                                       00030700
         MVC   DAPLECT(4),CPPLECT                                       00030800
         XC    ECB,ECB                 Clear Event control block        00030900
         LA    R0,ECB                  Address of our ECB               00031000
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00031100
         MVC   DAPLPSCB(4),CPPLPSCB                                     00031200
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00031300
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00031400
         L     R14,R14TS               Restore register 14              00031500
         BR    R14                                                      00031600
         DROP  R1,R2                   Unbase DAPL and CPPL             00031700
         TITLE 'Write message on screen'                                00031800
*---------------------------------------------------------------------* 00031900
*        Write the message on the terminal with a PUTLINE.            * 00032000
*        Register 0 = the length of the message.                      * 00032100
*        Register 1 = adress of the message.                          * 00032200
*---------------------------------------------------------------------* 00032300
TPUT     DS    0H                                                       00032400
         ST    R14,R14TPUT             Save register 14                 00032500
         L     R3,MYCPPL               Pickup CPPL of this command      00032600
         USING CPPL,R3                 Base IKJCPPL                     00032700
         MVI   PUTLINE+4,C' '          Clear output line                00032800
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00032900
         LR    R2,R0                   Length of message                00033000
         BCTR  R2,0                    Minus 1 for EX                   00033100
         EX    R2,MVEMSG               Move the message                 00033200
         LA    R2,5(,R2)               Length in including length field 00033300
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00033400
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00033500
         L     R2,CPPLUPT              User Profile Table               00033600
         L     R3,CPPLECT              Environment Control Table        00033700
         XC    ECB,ECB                 Force PUTLINE to wait            00033800
         LA    R0,PUTLINE              Data line address                00033900
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00034000
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00034100
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00034200
         L     R14,R14TPUT             Restore register 14              00034300
         BR    R14                                                      00034400
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00034500
         DROP  R3                      Unbase CPPL                      00034600
         TITLE 'Free SYS.SECURE.CNTL'                                   00034700
FREE     DS    0H                                                       00034800
         ST    R14,R14FREE             Save register 14                 00034900
         LA    R3,DAIR18               Point to unallocation parm block 00035000
         XC    DAIR18,DAIR18           Clear unallocation parm block    00035100
         USING DAPB18,R3               IKJDAP18                         00035200
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00035300
         MVI   DA18MNM,C' '            Provide no ...                   00035400
         MVC   DA18MNM+1(7),DA18MNM               member name           00035500
         MVC   DA18DDN,=CL8'RAKFUSER'  DDNAME to unallocate             00035600
         LR    R1,R3                   Parameter CALLTS                 00035700
         BAL   R14,CALLTS              IKJDAIR routine                  00035800
         L     R14,R14FREE             Restore register 14              00035900
         BR    R14                     Return                           00036000
         DROP  R3                      Unbase DAPB18                    00036100
         TITLE 'Close RAKFUSER'                                         00036200
CLOSE    ST    R14,R14CLOSE            Save register 14                 00036300
         MVI   CLOSED,X'80'            First and only DCB               00036400
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00036500
         L     R14,R14CLOSE            Restore register 14              00036600
         BR    R14                     Return                           00036700
         TITLE 'DCB abend exit'                                         00036800
DCBABEND DS    0H                                                       00036900
         TM    3(R1),B'00001110'       Processing allowed?              00037000
         BZR   R14                     No: continue with abend          00037100
         TM    3(R1),4                 Ignore bit on?                   00037200
         MVI   3(R1),0                 Prepare for NO                   00037300
         BZR   R14                                                      00037400
         MVC   DCBCOMP,0(R1)           Move completion code             00037500
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00037600
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00037700
         BNER  R14                     No: continue with abend          00037800
         MVI   3(R1),4                 Yes: ignore abend                00037900
         OI    SW,$913                 Indicate 913 abend               00038000
         BR    R14                     Return to Access Method          00038100
PCLSTART DS    0H                                                       00038200
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00038300
UIDPDE   IKJPOSIT JOBNAME,PROMPT='RAKF UserID',                        *00038400
               HELP=('a valid UserID')                                  00038500
GROUPKW  IKJKEYWD                                                       00038600
         IKJNAME 'GROUP',SUBFLD=GROUPSF,ALIAS='GRP'                     00038700
GROUPSF  IKJSUBF                                                        00038800
GROUPPDE IKJIDENT 'Group',                                             *00038900
               FIRST=ALPHA,OTHER=ALPHANUM,MAXLNTH=8,                   *00039000
               PROMPT='Specify a RAKF group'                            00039100
         IKJENDP                                                        00039200
PCL#L    EQU   *-PCLSTART                                               00039300
         TITLE 'CONSTANTS'                                              00039400
MDLUSER  DCB   DSORG=PS,LRECL=80,DDNAME=RAKFUSER,EODAD=USEREOF,        *00039500
               MACRF=(GM,PM)                                            00039600
MDLULEN  EQU   *-MDLUSER                                                00039700
*                                                                       00039800
USRDSNL  DC    AL2(L'USRDSN)                                            00039900
USRDSN   DC    C'SYS1.SECURE.CNTL'     RAKF control data set            00040000
*                                                                       00040100
MSG0     DC    C'DELUSER: DFLTGRP cannot be deleted'                    00040200
MSG1     DC    C'SYS1.SECURE.CNTL(USERS) could not be allocated'        00040300
MSG2     DC    C'DELUSER: GROUP in Password record cannot be deleted'   00040400
MSG3X    DC    C'DELUSER: xxxxxxxx access denied'  +9                   00040500
MSG4     DC    C'DELUSER: Nothing deleted'                              00040600
MSG5     DC    C'DELUSER: Parse error'                                  00040700
MSG6X    DC    C'DELUSER: User xxxxxxxx successfully deleted' +14       00040800
MSG7     DC    C'DELUSER: User table full, too many users'              00040900
MSGA     DC    C'DELUSER: Run RAKFUSER to activate the changes'         00041000
MSGBX    DC    C'DELUSER: User xxxxxxxx disconnected from Group xxxxxxx*00041100
               '                       +14, +47                         00041200
MSGY     DC    C'DELUSER: No ACEE found'                                00041300
MSGZ     DC    C'DELUSER: Not authorized, no SPECIAL attribute'         00041400
         LTORG ,                                                        00041500
