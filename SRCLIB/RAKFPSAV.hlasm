         TITLE 'Save Password Changes in RAKF USERS member'        @rp3 00000100
RAKFPSAV CSECT                                                          00000200
         PRINT NOGEN                                                    00000300
*                                                                       00000400
**********************************************************************  00000500
*                                                                    *  00000600
* NAME: RAKFPSAV                                                     *  00000700
*                                                                    *  00000800
* DESC: Save Password Changes in RAKF USERS member of              @rp3 00000900
*       SYS1.SECURE.CNTL.                                          @rp3 00001000
*                                                                    *  00001100
* FUNCTION: - read the password change queue created by RAKFPWUP     *  00001200
*             into memory                                            *  00001300
*           - loop through the RAKF USERS table and check each line@rp3 00001400
*             for a password change queue entry. If an entry exists  *  00001500
*             update encrypt the password with a salt + encrypted    *  00001600
*             32 byte field.                                         *  00001700
*           - clear the password change queue                        *  00001800
*                                                                    *  00001900
* REQUIREMENTS: - RAKF USERS  table pointed to by ddname RAKFUSER   @10 00002000
*               - RAKF password change queue pointed to by ddname    *  00002100
*                 RAKFPWUP, a sequential dataset with LRECL=18,      *  00002200
*                 RECFM=F and one line per password change in the    *  00002300
*                 following format:                                  *  00002400
*                                                                    *  00002500
*                 ----+----1----+---                                 *  00002600
*                 uuuuuuuu pppppppp                                  *  00002700
*                                                                    *  00002800
*                 where uuuuuuuu is the username and pppppppp is     *  00002900
*                 the new password, each padded to the right with    *  00003000
*                 blanks to 8 characters.                            *  00003100
*                                                                    *  00003200
*    2026/09/07 @10     Update the passwords from PWUP to the       @10 00003300
*                       USERS data set. Formerly the updated        @10 00003400
*                       passwords were unencrypted saved in the    @rp3 00003500
*                       USERS table, but since the passwords are   @rp3 00003600
*                       encrypted, the passwords will be saved      @10 00003700
*                       as SHA-256(salt||password) in the first     @10 00003800
*                       user record of the USERS data set          @rp3 00003900
*                       (Users record type 1).                     @rp3 00004000
*                                                                    *  00004100
*    2026/11/16 @rp3    Eliminate the need of the SHADOW dataset   @rp3 00004200
*                       the sha256(salt/password) will now be      @rp3 00004300
*                       saved in the first record of that user     @rp3 00004400
*                       That is the type 1 user record with the    @rp3 00004500
*                       following fields:                          @rp3 00004600
*                       1. Userid - 8 bytes                        @rp3 00004700
*                       2. Type - 1 byte containing '1'            @rp3 00004800
*                       3. Group - 8 bytes                         @rp3 00004900
*                       4. DFLTGRP indicator containing '*' or ' ' @rp3 00005000
*                       5. Filler - 1 byte                         @rp3 00005100
*                       6. Operations flag - 1 byte with 'Y' or 'N'@rp3 00005200
*                       7. Filler - 1 byte                         @rp3 00005300
*                       8. Special flag - 1 byte with 'Y' or 'N'   @rp3 00005400
*                       9. Filler - 1 byte                         @rp3 00005500
*                      10. Salt - 8 bytes                          @rp3 00005600
*                      10. Hashed password - 32 bytes.             @rp3 00005700
********************************************************************@10 00005800
*                                                                       00005900
* initialize                                                            00006000
*                                                                       00006100
         SAVE  (14,12),,RAKFPSAV_&SYSDATE._&SYSTIME                     00006200
         USING RAKFPSAV,R15        Establish => program EP              00006300
         ST    R13,SAVEAREA+4      Backward pointer                     00006400
         LA    R11,SAVEAREA        Establish => savearea                00006500
         ST    R11,8(,R13)         Forward pointer                      00006600
         LR    R13,R11             User R13 as base register       @rp3 00006700
         USING SAVEAREA,R13        New addressability                   00006800
         DROP  R15                 Program EP no longer needed          00006900
         B     CONTINUE            Branch around savearea               00007000
SAVEAREA DS    18F                 Savearea                             00007100
*                                                                       00007200
* first read of password change queue to determine number of changes    00007300
*                                                                       00007400
CONTINUE XR    R5,R5               Initialize changes counter           00007500
         XR    R6,R6               Initialize changes buffer size       00007600
         OPEN  (RAKFPWUP,(INPUT))  Open password change queue           00007700
SIZELOOP GET   RAKFPWUP,PWUP       Get change record                    00007800
         LA    R5,1(,R5)           Increment changes counter            00007900
         A     R6,CHGRECL          Increment buffer size                00008000
         B     SIZELOOP            Read next change record              00008100
ENDPWUP  CLOSE (RAKFPWUP)          Close password change queue          00008200
         LTR   R5,R5               Password changes queued?        @rp3 00008300
         BZ    RETURN              No: nothing to do               @rp3 00008400
*                                                                       00008500
* second read of password change queue loads all changes in storage     00008600
*                                                                       00008700
         ST    R5,NCHANGES         Remember number of changes           00008800
         ST    R6,CHGBSIZE         Remember changes buffer size         00008900
         GETMAIN RU,LV=CHGBSIZE    Get storage for changes buffer       00009000
         ST    R1,ACHGBUF          Remember changes buffer address      00009100
         OPEN  (RAKFPWUP,(INPUT))  Re-open password change queue        00009200
         A     R6,ACHGBUF          One byte beyond change buffer        00009300
         USING PWUP,R6             Establish changes addressability     00009400
CHGREAD  S     R6,CHGRECL          Address record for backward read     00009500
         GET   RAKFPWUP,PWUP       Get change record                    00009600
         BCT   R5,CHGREAD          Read next until all done             00009700
         CLOSE (RAKFPWUP)          Close password change queue          00009800
*                                                                       00009900
*        Update RAKF USERS table                                        00010000
*                                                                       00010100
         RDJFCB (RAKFUSER)         Find out user table DSN for ENQ  @10 00010200
         MODESET MODE=SUP,KEY=ZERO Authorize ourselves for SYSDSN ENQ   00010300
         ENQ   (SYSDSN,JFCBDSNM,E,44,SYSTEM),RET=HAVE   serialization   00010400
         ENQ   (SPFEDIT,JFCBDSNM,E,52,SYSTEMS),RET=HAVE serialization   00010500
         MODESET MODE=PROB,KEY=NZERO   Return to problem state          00010600
         OPEN  (RAKFUSER,(UPDAT))      Open Users data set         @rp3 00010700
         USING USERREC,R3              Address the USERS recordl   @rp3 00010800
USERLOOP GET   RAKFUSER                Read a record from USERS    @rp3 00010900
         LR    R3,R1                   Save address of record      @rp3 00011000
         L     R5,NCHANGES             Get number of changes            00011100
         L     R6,ACHGBUF              Get changes buffer address       00011200
PWDLOOP  CLC   USERUID,PWUPUSER        Do we have an update?       @rp3 00011300
         BNE   NEXTLOOP                No: next record             @rp3 00011400
         CLI   USER#,C'1'              Is it record type 1?        @rp3 00011500
         BE    UPDATEPW                Updated PW only in record 1 @rp3 00011600
NEXTLOOP A     R6,CHGRECL              Address next entry               00011700
         BCT   R5,PWDLOOP         Check next password change record@rp3 00011800
         B     USERLOOP           No update found, process next usr@rp3 00011900
UPDATEPW DS    0H                      TOD clock in salt            @10 00012000
*---------------------------------------------------------------------* 00012100
*        Initialize the Salt with the TOD clock and call RAKFPWH    @10 00012200
*        to create  SHA256(salt||password) and store this in the    @10 00012300
*        first record of the UserId in the USERS data set          @rp3 00012400
*---------------------------------------------------------------------* 00012500
         STCK  USERSALT                Salt = the TOD clock        @rp3 00012600
         MVC   WORKPASS+1,PWUPPSWD     Password from PWUP           @10 00012700
         LA    R1,WORKPASS+1           Start of password            @10 00012800
         LA    R0,8                    Maximum length               @10 00012900
         XR    R2,R2                   Count password bytes         @10 00013000
UPDPW1   CLI   0(R1),C' '              Blank found?                 @10 00013100
         BE    UPDPW2                  Yes: we know the length      @10 00013200
         LA    R1,1(,R1)               Next byte in password        @10 00013300
         LA    R2,1(,R2)               Increase length              @10 00013400
         BCT   R0,UPDPW1               Loop until all done          @10 00013500
UPDPW2   STC   R2,WORKPASS             We need the length for hash  @10 00013600
         LA    R0,USERSALT             Salt in USERS record        @rp3 00013700
         ST    R0,HWPL+0               In parmlist                  @10 00013800
         LA    R0,WORKPASS+1                                        @10 00013900
         ST    R0,HWPL+4               In parmlist                  @10 00014000
         XR    R1,R1                   Clear register               @10 00014100
         IC    R1,WORKPASS             Gotten password length       @10 00014200
         ST    R1,HWPWLEN              Save in RAKFPWH list         @10 00014300
         LA    R0,HWPWLEN                                           @10 00014400
         ST    R0,HWPL+8               In parmlist                  @10 00014500
         LA    R0,USERHASH             Output field                @rp3 00014600
         ST    R0,HWPL+12              In parmlist                  @10 00014700
         LA    R0,HWWORK               Work area                    @10 00014800
         ST    R0,HWPL+16              In parmlist                  @10 00014900
         LA    R1,HWPL                 Parmlist                     @10 00015000
         ST    R13,HWR13               Save our area address        @10 00015100
         LR    R4,R13                  Save our area address        @10 00015200
         L     R15,=V(RAKFPWH)         Hashing routine              @10 00015300
         LA    R13,HWSAVE                                           @10 00015400
         BALR  R14,R15                 Encrypt                      @10 00015500
         LR    R13,R4                  Restore our SA address       @10 00015600
         PUTX  RAKFUSER                Update USERS record in place@rp3 00015700
         B     USERLOOP                Update next user if any     @rp3 00015800
*                                                                   @10 00015900
ENDUSER  CLOSE (RAKFUSER)              Close USERS table           @rp3 00016000
         DROP  R3                  Users table record no longer need@10 00016100
         MODESET MODE=SUP,KEY=ZERO authorize ourselves for SYSDSN DEQ   00016200
         DEQ   (SPFEDIT,JFCBDSNM,52,SYSTEMS),RET=HAVE release ENQ       00016300
         DEQ   (SYSDSN,JFCBDSNM,44,SYSTEM),RET=HAVE   release ENQ       00016400
         MODESET MODE=PROB,KEY=NZERO return to problem state            00016500
         OPEN  (RAKFPWUP,(OUTPUT)) clear ..                             00016600
         CLOSE (RAKFPWUP)                 .. password change queue      00016700
*                                                                       00016800
* clear and free change queue buffer                                    00016900
*                                                                       00017000
         L     R5,NCHANGES         Get number of changes                00017100
         L     R6,ACHGBUF          Get changes buffer address           00017200
CLRLOOP  XC    PWUP(CHGLRECL),PWUP Clear record                         00017300
         A     R6,CHGRECL          Address next entry                   00017400
         BCT   R5,CLRLOOP          Clear next change record             00017500
         DROP  R6                  Changes buffer no longer needed      00017600
         FREEMAIN RU,LV=CHGBSIZE,A=ACHGBUF free changes buffer          00017700
*                                                                       00017800
* cleanup and return                                                    00017900
*                                                                       00018000
         XC    PWUP(CHGLRECL),PWUP Clear local changes queue record     00018100
RETURN   L     R13,SAVEAREA+4      Get caller's savearea                00018200
         RETURN (14,12),,RC=0      Return                               00018300
*                                                                       00018400
* data area                                                             00018500
*                                                                       00018600
CHGBSIZE DS    F                   Size of changes queue buffer         00018700
ACHGBUF  DS    F                   Address of changes queue buffer      00018800
NCHANGES DS    F                   Number of changes in queue           00018900
WORKPASS DS    CL9                 Proposed length + password       @10 00019000
CHGRECL  DC    A(CHGLRECL)         Record length of changes queue       00019100
*                                                                       00019200
HASHWKD  DS    0CL772              Area for RAKFPWH                 @10 00019300
HWPL     DS    5F                  Parmlist (salt,pw,pwlen,out,work)@10 00019400
HWPWLEN  DS    F                   Candidate password length        @10 00019500
HWR13    DS    F                   Saved caller save-area pointer   @10 00019600
HWOUT    DS    CL32                Computed SHA-256 hash            @10 00019700
HWSAVE   DS    18F                 Save area for the RAKFPWH call   @10 00019800
HWWORK   DS    CL640               RAKFPWH work area (>= RPWWORKL)  @10 00019900
*                                                                       00020000
SYSDSN   DC    CL8'SYSDSN'         resource name for enqueue            00020100
SPFEDIT  DC    CL8'SPFEDIT'        resource name for enqueue            00020200
RAKFPWUP DCB   DDNAME=RAKFPWUP,MACRF=(GM,PM),EODAD=ENDPWUP,DSORG=PS     00020300
RAKFUSER DCB   DDNAME=RAKFUSER,MACRF=(GL,PM),EODAD=ENDUSER,DSORG=PS,   X00020400
               EXLST=JFCB          DCB with exit list for RDJFCB        00020500
JFCB     DS    0F                  the exit list contains only ..       00020600
         DC    X'87'                .. the target JFCB address ..       00020700
         DC    AL3(INFMJFCB)        .. for RDJFCB                       00020800
         IEFJFCBN                  RDJFCB target                        00020900
         LTORG ,                   all literals go here                 00021000
PWUP     DS    0C                  changes queue record                 00021100
PWUPUSER DC    CL8' '              userid                               00021200
         DC    C' '                filler                               00021300
PWUPPSWD DC    CL8' '              new password                         00021400
         DC    C' '                filler                               00021500
CHGLRECL EQU   *-PWUP              record length of changes queue       00021600
*                                                                       00021700
*        RAKF Users record type 1.                                 @rp3 00021800
*                                                                       00021900
USERREC  DSECT                         User record                 @rp3 00022000
USERTYP  DS    0CL9                    UserId + record type (1 or 2@rp3 00022100
USERUID  DS    CL8                     Contains UserID             @rp3 00022200
USER#    DS    C                       Contains 1 or 2             @rp3 00022300
*                                      1 = user record 2 =         @rp3 00022400
USERGRP  DS    CL8                     Connected group             @rp3 00022500
USERDFT  DS    C                       Contains a star if DFLTGRP  @rp3 00022600
USERPWD  DS    CL8                     Password is blanked out     @rp3 00022700
         DS    C                                                   @rp3 00022800
USEROPR  DS    C           Operations / Nooperations (if USER# = 1)@rp3 00022900
         DS    C                                                   @rp3 00023000
USERSPE  DS    C             Special / Nospecial (only if USER# =1)@rp3 00023100
         DS    C                                                   @rp3 00023200
USERSALT DS    CL8                     Salt (only if USER# = 1)    @rp3 00023300
USERHASH DS    CL32             Hashed password (only if USER# = 1)@rp3 00023400
*                                                                       00023500
R0       EQU   0                                                    @10 00023600
R1       EQU   1                                                    @10 00023700
R2       EQU   2                                                    @10 00023800
R3       EQU   3                                                    @10 00023900
R4       EQU   4                                                    @10 00024000
R5       EQU   5                   # entries in PWUP table          @10 00024100
R6       EQU   6                   Entry in PWUP table              @10 00024200
R7       EQU   7                                                    @10 00024300
R8       EQU   8                                                    @10 00024400
R9       EQU   9                                                    @10 00024500
R10      EQU   10                                                   @10 00024600
R11      EQU   11                                                   @10 00024700
R12      EQU   12                                                   @10 00024800
R13      EQU   13                      Base register                @10 00024900
R14      EQU   14                                                   @10 00025000
R15      EQU   15                                                   @10 00025100
         END   RAKFPSAV                End of program                   00025200
