ADDSD    TITLE 'Add RAKF profile records'                               00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       ADDSD                                          * 00000400
*        Alias:        AD                                             * 00000500
*                                                                     * 00000600
*        Author:       Rob Prins                                      * 00000700
*                                                                     * 00000800
*        Attributes:   RENT, REUS.                                    * 00000900
*                                                                     * 00001000
*        Function:     Parse the syntax of the ADDSD   command.       * 00001100
*                      Allocate SYS1.SECURE.CNTL(PROFILES)            * 00001200
*                      dynamically with IKJDAIR.                      * 00001300
*                      GETMAIN room for 1500 profiles.                * 00001400
*                      Read the PROFILES member into the table and    * 00001500
*                      skip the comments records.                     * 00001600
*                      Add new RAKF profiles in the PROFILES table.   * 00001700
*                      Sort the table alpabetically.                  * 00001800
*                                                                     * 00001900
*                      Write the PROFILES table back.                 * 00002000
*                      Free the SYS1.SECURE.CNTL data set.            * 00002100
*                                                                     * 00002200
*        Syntax:       ADDSD  profile UACC(NONE/READ/UPDATE/CONTROL   * 00002300
*                             ALTER)                                  * 00002400
*                                                                     * 00002500
*                      Required: profile                              * 00002600
*                                                                     * 00002700
*                      Default: UACC(NONE)                            * 00002800
*                                                                     * 00002900
*        Return codes: 00 - all good.                                 * 00003000
*                      08 - an error occurred, user is notified       * 00003100
*                           with a message                            * 00003200
*                                                                     * 00003300
*---------------------------------------------------------------------* 00003400
ADDSD    CSECT                                                          00003500
         SAVE  (14,12),,*                                               00003600
         LR    R12,R15                                                  00003700
         USING ADDSD,R12               Base register                    00003800
         LR    R2,R1                   Save parm (CPPL)                 00003900
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004000
         ST    R1,8(,R13)              Forward pointer                  00004100
         ST    R13,4(,R1)              Backward pointer                 00004200
         LR    R13,R1                  This is our save area            00004300
         USING WORKAREA,R13            Base working storage             00004400
         ST    R2,MYCPPL               Save our CPPL address            00004500
         MVC   RAKFPROF,MDLPROF        Move model DCB to working strg   00004600
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00004700
         XC    DAIR18,DAIR18                        ... blocks          00004800
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00004900
         XC    PPL#LA,PPL#LA           Clear PPL pointers               00005000
         MVC   MSG3,MSG3X              Move message to working storage  00005100
         MVC   MSG9,MSG9X              Move message to working storage  00005200
         MVI   PROFREC-1,C' '          To blank Profile record          00005300
         MVC   CLASS,=CL8'DATASET'     ADDSD serves the DATASET class   00005400
         MVI   SW,0                    Clear flags                      00005500
         LA    R0,DCBABEND             DCB abend exit                   00005600
         ST    R0,EXLST                Save JFCB in exit list           00005700
         MVI   EXLST,X'91'             DCB abend exit is last entry     00005800
         LA    R0,EXLST                Exit list (DCB abend exit)       00005900
         STCM  R0,B'0111',RAKFPROF+DCBEXLSA-IHADCB                      00006000
         GETMAIN RU,LV=120000      GETMAIN room for 1500 profiles       00006100
         ST    R1,ADRPROF              Save its address                 00006200
         USING PSA,R0                  Point to CVT                     00006300
         L     R2,PSAANEW              Load ASCB                        00006400
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00006500
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00006600
         BNZ   CONT1                   Yes: found                       00006700
         LA    R1,MSGY                 Msg: 'No ACEE found'             00006800
         LA    R0,L'MSGY               Length                           00006900
         BAL   R14,TPUT                Write the message on screen      00007000
         B     RC08                    End with RC=-08                  00007100
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00007200
         BO    CONT2                                                    00007300
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007400
         LA    R0,L'MSGZ               Length                           00007500
         BAL   R14,TPUT                Write the message on screen      00007600
         B     RC08                    End with RC=-08                  00007700
CONT2    DS    0H                                                       00007800
*---------------------------------------------------------------------* 00007900
*        Parse parameters                                             * 00008000
*---------------------------------------------------------------------* 00008100
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00008200
         STM   R0,R1,PPL#LA            Save length and address of PPL   00008300
         L     R2,PPL#PTR              Get the address of the PPL       00008400
         USING PPL,R2                  Adress it                        00008500
         L     R1,MYCPPL               Get address of CPPL              00008600
         USING CPPL,R1                 Address it                       00008700
*---------------------------------------------------------------------* 00008800
*                                                                       00008900
*        Populate the Parse Parameter List (PPL) from the CPPL,         00009000
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00009100
*                                                                       00009200
*---------------------------------------------------------------------* 00009300
*                                                                       00009400
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00009500
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00009600
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00009700
*                                      From the CPPL                    00009800
         XC    ECB,ECB                 Clear Event control block        00009900
         L     R1,=A(ADDPCL)           Address of PCL                   00010000
         ST    R1,PPLPCL               Set in PPL                       00010100
         LA    R1,ANSWER               Answer area                      00010200
         ST    R1,PPLANS               Pointer into PPL                 00010300
         LA    R1,ECB                  Event control block              00010400
         ST    R1,PPLECB               Pointer into PPL                 00010500
         ST    R13,PPLUWA              User provide workarea            00010600
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00010700
         DROP  R1,R2                   CPPL and PPL                     00010800
         LTR   R15,R15                 Parse successfully processed?    00010900
         BZ    PARSEOK                 Yes: carry                       00011000
         LA    R0,L'MSG5               Length                           00011100
         LA    R1,MSG5                 Message                          00011200
         BAL   R14,TPUT                                                 00011300
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00011400
         B     RC08                    Return to TMP                    00011500
PARSEOK  DS    0H                                                       00011600
         L     R8,ANSWER               Pointer to PDL                   00011700
         USING ADDPRS,R8               mapped with IKJPARM              00011800
         MVI   PROFILE,C' '                                             00011900
         MVC   PROFILE+1(L'PROFILE-1),PROFILE initialize profile        00012000
         LA    R3,PROFPDE              Profile PDE                      00012100
         USING PROFRET,R3              Base this PDE                    00012200
         L     R1,PROFPTR              Pointer to Profile name          00012300
         LH    R2,PROFL                Length                           00012400
         BCTR  R2,0                    -1 for EX                        00012500
         EX    R2,MVEPROF              Move Profile                     00012600
         B     ENDPARS                 Branch over EX                   00012700
MVEPROF  MVC   PROFILE(0),0(R1)        << Executed >>                   00012800
         DROP  R3                      Unbase CLASRET                   00012900
ENDPARS  DS    0H                                                       00013000
*---------------------------------------------------------------------* 00013100
*        Allocate SYS1.SECURE.CNTL(PROFILES)                          * 00013200
*---------------------------------------------------------------------* 00013300
         LA    R3,DAIR08               Allocation request block         00013400
         USING DAPB08,R3               Base DAPB08                      00013500
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00013600
         MVC   DA08DDN,=CL8'RAKFPROF'  DDNAME to allocate               00013700
         MVC   DA08PDSN,=A(PROFDSNL)   Temporary data set name          00013800
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00013900
         MVC   DA08MNM,=CL8'PROFILES'  Fixed member name                00014000
         MVI   DA08UNIT,C' '           Clear unit name                  00014100
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00014200
         MVI   DA08SER,C' '            Clear volume serial              00014300
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00014400
         LR    R1,R3                   Parameter CALLTS                 00014500
         BAL   R14,CALLTS              IKJDAIR routine                  00014600
         LTR   R15,R15                 Allocation OK?                   00014700
         BZ    ADDP001                 Yes: carry on                    00014800
         LA    R1,MSG1                 Msg: 'allocation error PROF'     00014900
         LA    R0,L'MSG1               Length                           00015000
         BAL   R14,TPUT                Write the message on screen      00015100
         B     RC08                    Return code 8                    00015200
ADDP001  DS    0H                                                       00015300
*---------------------------------------------------------------------* 00015400
*        Open SYS1.SECURE.CNTL(PROFILES) with DDNAME RAKPROF          * 00015500
*---------------------------------------------------------------------* 00015600
         MVI   OPEND,X'80'             First and only DCB               00015700
         OPEN  RAKFPROF,MF=(E,OPEND)                                    00015800
         TM    SW,$913                 Access denied?                   00015900
         BNO   ADDP005                 No: assumed, that open is succes 00016000
         MVC   MSG3+7(8),=CL8'RAKFPROF'  DD-name                        00016100
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00016200
         LA    R0,L'MSG3               Length                           00016300
         BAL   R14,TPUT                Write the message on screen      00016400
         BAL   R14,FREE                Free the data sets               00016500
         B     RC08                    Return code 8                    00016600
ADDP005  DS    0H                                                       00016700
*---------------------------------------------------------------------* 00016800
*        Read the PROFILES records and check if the profile is        * 00016900
*        already added.                                               * 00017000
*        And populate the table with Profile records.                 * 00017100
*---------------------------------------------------------------------* 00017200
         XR    R5,R5                   Clear record counter             00017300
         L     R6,ADRPROF              Start of Profile table           00017400
READPROF DS    0H                                                       00017500
         GET   RAKFPROF,PROFREC        Read a record                    00017600
         CLI   PROFREC,C'*'            Comment record?                  00017700
         BE    READPROF                Yes: skip                        00017800
         LA    R5,1(,R5)               Count record                     00017900
         C     R5,=F'1495'             Already 1495 records in table?   00018000
         BL    ADDP010                 No: room enough                  00018100
         LA    R1,MSG7                 Msg: 'table full'                00018200
         LA    R0,L'MSG7               Length                           00018300
         BAL   R14,TPUT                Write the message on screen      00018400
         BAL   R14,CLOSE               Close RAKFPROF                   00018500
         BAL   R14,FREE                Free the data sets               00018600
         B     RC08                    Return code 8                    00018700
ADDP010  CLC   PROFCPR,CLPROF          Match found of Class/Profile?    00018800
         BNE   ADDP011                 No: good                         00018900
         LA    R1,MSG4                 Msg: 'PROFILE already defined'   00019000
         LA    R0,L'MSG4               Length                           00019100
         BAL   R14,TPUT                Write the message on screen      00019200
         BAL   R14,CLOSE               Close the data sets              00019300
         BAL   R14,FREE                Free the data sets               00019400
         B     RC08                    Return code 8                    00019500
ADDP011  DS    0H                                                       00019600
         MVC   0(80,R6),PROFREC        Record into table                00019700
         LA    R6,80(,R6)              Next entry in table              00019800
         B     READPROF                Read next record                 00019900
PROFEOF  DS    0H                      EOF RACFPROF                     00020000
*                                                                       00020100
*---------------------------------------------------------------------* 00020200
*        Sort the Profile table alphabetically and                    * 00020300
*        write the Profile records in the Profile table.              * 00020400
*---------------------------------------------------------------------* 00020500
         MVC   PROFREC,PROFREC-1       Clear profile record             00020600
         MVC   PROFCLS,CLASS           Class name                       00020700
         MVC   PROFPRF,PROFILE         Move profile                     00020800
         LH    R1,UACC                 UACC PDL                         00020900
         MH    R1,=H'10'               Times 10 (MVC + B)               00021000
         B     *+4(R1)                 Branchlist                       00021100
         MVC   PROFACC,=CL8'NONE'      Default (0)                      00021200
         B     UACEND                                                   00021300
         MVC   PROFACC,=CL8'NONE'      (1)                              00021400
         B     UACEND                                                   00021500
         MVC   PROFACC,=CL8'READ'      (2)                              00021600
         B     UACEND                                                   00021700
         MVC   PROFACC,=CL8'UPDATE'    (3)                              00021800
         B     UACEND                                                   00021900
         MVC   PROFACC,=CL8'CONTROL'   (4)                              00022000
         B     UACEND                                                   00022100
         MVC   PROFACC,=CL8'ALTER'     (5)                              00022200
UACEND   MVC   0(80,R6),PROFREC        Move record in table             00022300
         LA    R5,1(,R5)               Count record                     00022400
         MVI   CLOSED,X'80'            First and only DCB               00022500
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00022600
SORT     STM   R4,R8,SAVESORT                                           00022700
         LR    R7,R5                   Copy record counter              00022800
         L     R2,ADRPROF              Point to first record            00022900
         CH    R7,=H'2'                Less than 2 records?             00023000
         BL    ENDSORT                 Do not sort                      00023100
         BCTR  R7,0                    Minus 1                          00023200
         MH    R7,=H'80'               ** Record length                 00023300
         LA    R7,0(R2,R7)             Point to last record             00023400
*                                                                       00023500
SORT01   DS    0H                      Start sort                       00023600
         ST    R7,SWAPLAST             Last record swapped              00023700
         L     R4,ADRPROF              Point to first record            00023800
         LR    R5,R4                   Next                             00023900
         LA    R5,80(,R4)                   Record                      00024000
SORT03   DS    0H                                                       00024100
         CL    R4,SWAPLAST             Last record reached?             00024200
         BNL   SORT07                  Yes: loop complete               00024300
         CLC   0(72,R4),0(R5)          Compare (skip s\\\ence numbers)  00024400
         BNH   SORT05                  High: swap these records         00024500
         XC    0(80,R4),0(R5)          Swap                             00024600
         XC    0(80,R5),0(R4)              the                          00024700
         XC    0(80,R4),0(R5)                   records                 00024800
         LR    R7,R4                   Last record swapped in R7        00024900
SORT05   DS    0H                      Load next entry                  00025000
         LA    R4,80(,R4)              Next recodd                      00025100
         LA    R5,80(,R5)              Next record                      00025200
         B     SORT03                  Compare next record              00025300
SORT07   DS    0H                      All records done                 00025400
         CL    R7,SWAPLAST             Are these swaps executed?        00025500
         BL    SORT01                  No: sort them again              00025600
*                                      Else end of sort                 00025700
ENDSORT  LM    R4,R8,SAVESORT          Restore registers                00025800
         MVI   OPEND,X'80'             First and only DCB               00025900
         OPEN  (RAKFPROF,(OUTPUT)),MF=(E,OPEND)                         00026000
         TM    SW,$913                 Access denied?                   00026100
         BNO   ADDP017                 No: assumed, that open is succes 00026200
         MVC   MSG3+9(8),=CL8'RAKFPROF'  DD-name                        00026300
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00026400
         LA    R0,L'MSG3               Length                           00026500
         BAL   R14,TPUT                Write the message on screen      00026600
         BAL   R14,CLOSE               Close the DCBs                   00026700
         BAL   R14,FREE                Free the data sets               00026800
         B     RC08                    Return code 8                    00026900
ADDP017  L     R6,ADRPROF              Max 1500 profile entries         00027000
*---------------------------------------------------------------------* 00027100
*        Write the RAKF Profiles back in the PROFILES member.         * 00027200
*---------------------------------------------------------------------* 00027300
ADDP019  DS    0H                                                       00027400
         PUT   RAKFPROF,0(R6)          Write ...                        00027500
         LA    R6,80(,R6)                    Profile ...                00027600
         BCT   R5,ADDP019                         table back            00027700
         MVC   MSG9PROF,PROFILE        Profile in success message       00027800
         MVC   MSG9CLS,CLASS           Class in success message         00027900
         LA    R1,MSG9                 Success message                  00028000
         LA    R0,L'MSG9               Length                           00028100
         BAL   R14,TPUT                Write the message on screen      00028200
         LA    R1,MSGA                 Msg: Run RAKFPROF ...            00028300
         LA    R0,L'MSGA               Length                           00028400
         BAL   R14,TPUT                Write the message on screen      00028500
         BAL   R14,CLOSE               Close the data sets              00028600
         BAL   R14,FREE                And unallocate                   00028700
         LA    R15,0                   RC = 0                           00028800
         B     RETURN                                                   00028900
*---------------------------------------------------------------------* 00029000
*        Return to TSO TMP.                                           * 00029100
*---------------------------------------------------------------------* 00029200
RC08     DS    0H                                                       00029300
         LA    R15,8                   RC = 8                           00029400
RETURN   DS    0H                                                       00029500
         LR    R4,R15                  Save return code                 00029600
         ICM   R2,15,PPL#LA            Is the PPL allocated?            00029700
         BZ    RETURN1                 No: do not free                  00029800
         LM    R2,R3,PPL#LA            Load length and address of PPL   00029900
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00030000
RETURN1  ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00030100
         BZ    RETURN2                 No: skip                         00030200
         IKJRLSA (R8)                  Release PARSE storage            00030300
RETURN2  L     R2,ADRPROF              Address of Profile table         00030400
         FREEMAIN RU,LV=120000,A=(2)                                    00030500
         LR    R3,R13                  Load working storage to free     00030600
         L     R13,4(,R13)             Load caller's save area          00030700
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00030800
         LR    R15,R4                  Restore return code              00030900
         RETURN (14,12),RC=(15)        Return                           00031000
*                                                                       00031100
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00031200
*---------------------------------------------------------------------* 00031300
*        Routine:   CALLTS                                            * 00031400
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00031500
*                   Register 1 contains the address of the allocation * 00031600
*                   or unallocation DAIR parameter blocks.            * 00031700
*---------------------------------------------------------------------* 00031800
CALLTS   DS    0H                                                       00031900
         ST    R14,R14TS               Save register 14                 00032000
         LR    R14,R1                  Save A(IKJDAIR parm block)       00032100
         XC    ECB,ECB                 Clear ECB                        00032200
         LA    R1,DAIRDAPL                                              00032300
         L     R2,MYCPPL               Pickup our CPPL                  00032400
         USING CPPL,R2                 Base CPPL                        00032500
         USING DAPL,R1                 Base IKJDAPL                     00032600
         MVC   DAPLUPT(4),CPPLUPT                                       00032700
         MVC   DAPLECT(4),CPPLECT                                       00032800
         XC    ECB,ECB                 Clear Event control block        00032900
         LA    R0,ECB                  Address of our ECB               00033000
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00033100
         MVC   DAPLPSCB(4),CPPLPSCB                                     00033200
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00033300
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00033400
         L     R14,R14TS               Restore register 14              00033500
         BR    R14                                                      00033600
         DROP  R1,R2                   Unbase DAPL and CPPL             00033700
         TITLE 'Write message on screen'                                00033800
*---------------------------------------------------------------------* 00033900
*        Write the message on the terminal with a PUTLINE.            * 00034000
*        Register 0 = the length of the message.                      * 00034100
*        Register 1 = adress of the message.                          * 00034200
*---------------------------------------------------------------------* 00034300
TPUT     DS    0H                                                       00034400
         ST    R14,R14TPUT             Save register 14                 00034500
         L     R3,MYCPPL               Pickup CPPL of this command      00034600
         USING CPPL,R3                 Base IKJCPPL                     00034700
         MVI   PUTLINE+4,C' '          Clear output line                00034800
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00034900
         LR    R2,R0                   Length of message                00035000
         BCTR  R2,0                    Minus 1 for EX                   00035100
         EX    R2,MVEMSG               Move the message                 00035200
         LA    R2,5(,R2)               Length in including length field 00035300
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00035400
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00035500
         L     R2,CPPLUPT              User Profile Table               00035600
         L     R3,CPPLECT              Environment Control Table        00035700
         XC    ECB,ECB                 Force PUTLINE to wait            00035800
         LA    R0,PUTLINE              Data line address                00035900
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00036000
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00036100
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00036200
         L     R14,R14TPUT             Restore register 14              00036300
         BR    R14                                                      00036400
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00036500
         DROP  R3                      Unbase CPPL                      00036600
         TITLE 'Free SYS1.SECURE.CNTL'                                  00036700
FREE     DS    0H                                                       00036800
         ST    R14,R14FREE             Save register 14                 00036900
         LA    R3,DAIR18               Point to unallocation parm block 00037000
         XC    DAIR18,DAIR18           Clear unallocation parm block    00037100
         USING DAPB18,R3               IKJDAP18                         00037200
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00037300
         MVI   DA18MNM,C' '            Provide no ...                   00037400
         MVC   DA18MNM+1(7),DA18MNM               member name           00037500
         MVC   DA18DDN,=CL8'RAKFPROF'  DDNAME to unallocate             00037600
         LR    R1,R3                   Parameter CALLTS                 00037700
         BAL   R14,CALLTS              IKJDAIR routine                  00037800
         L     R14,R14FREE             Restore register 14              00037900
         BR    R14                     Return                           00038000
         DROP  R3                      Unbase DAPB18                    00038100
         TITLE 'Close RAKFPROF'                                         00038200
CLOSE    ST    R14,R14CLOSE            Save register 14                 00038300
         MVI   CLOSED,X'80'            First and only DCB               00038400
         CLOSE RAKFPROF,MF=(E,CLOSED)                                   00038500
         L     R14,R14CLOSE            Restore register 14              00038600
         BR    R14                     Return                           00038700
         TITLE 'DCB abend exit'                                         00038800
DCBABEND DS    0H                                                       00038900
         TM    3(R1),B'00001110'       Processing allowed?              00039000
         BZR   R14                     No: continue with abend          00039100
         TM    3(R1),4                 Ignore bit on?                   00039200
         MVI   3(R1),0                 Prepare for NO                   00039300
         BZR   R14                                                      00039400
         MVC   DCBCOMP,0(R1)           Move completion code             00039500
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00039600
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00039700
         BNER  R14                     No: continue with abend          00039800
         MVI   3(R1),4                 Yes: ignore abend                00039900
         OI    SW,$913                 Indicate 913 abend               00040000
         BR    R14                     Return to Access Method          00040100
PCLSTART DS    0H                                                       00040200
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00040300
PROFPDE  IKJPOSIT DSTHING,PROMPT='RAKF Profile name',                  *00040400
               HELP=('a valid profile e.g. SYS1.*')                     00040500
UACCKW   IKJKEYWD                                                       00040600
         IKJNAME 'UACC',SUBFLD=UACCSF                                   00040700
UACCSF   IKJSUBF                                                        00040800
UACC     IKJKEYWD                                                       00040900
         IKJNAME 'NONE'                                                 00041000
         IKJNAME 'READ'                                                 00041100
         IKJNAME 'UPDATE'                                               00041200
         IKJNAME 'CONTROL'                                              00041300
         IKJNAME 'ALTER'                                                00041400
         IKJENDP                                                        00041500
PCL#L    EQU   *-PCLSTART                                               00041600
         TITLE 'CONSTANTS'                                              00041700
MDLPROF  DCB   DSORG=PS,LRECL=80,DDNAME=RAKFPROF,EODAD=PROFEOF,        *00041800
               MACRF=(GM,PM)                                            00041900
