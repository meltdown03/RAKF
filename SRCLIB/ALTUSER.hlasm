ALTUSER  TITLE 'Change RAKF users with encrypted passwords'             00000100
*---------------------------------------------------------------------* 00000200
*                                                                     * 00000300
*        Module:       ALTUSER                                        * 00000400
*        Alias:        ALU                                            * 00000500
*                                                                     * 00000600
*        Author:       Rob Prins                                      * 00000700
*                                                                     * 00000800
*        Attributes:   RENT, REUS.                                    * 00000900
*                                                                     * 00001000
*        Function:     Parse the syntax of the ALTUSER command.       * 00001100
*                      Allocate SYS1.SECURE.CNTL(USERS)               * 00001200
*                      dynamically with IKJDAIR.                      * 00001300
*                      Change RAKF users in the USERS table,          * 00001400
*                      if (NO)OPERATIONS, (NO)SPECIAL, DFLTGRP        * 00001500
*                      and/or the PASSWORD are specified.             * 00001600
*                      If the DFLTGRP is changed, remove the star     * 00001700
*                      from the other groups of the same user.        * 00001800
*                      Change salt + hashed output in record type     * 00001900
*                      1 of the UserId in the USERS table if the      * 00002000
*                      PASSWORD is specified.                         * 00002100
*                      Free the SYS1.SECURE.CNTL data set.            * 00002200
*                                                                     * 00002300
*        Syntax:       ALTUSER userid PASSWORD(pppppppp) +            * 00002400
*                      DFLTGRP(group) +                               * 00002500
*                      OPERATIONS/NOOPERATIONS SPECIAL/NOSPECIAL      * 00002600
*                                                                     * 00002700
*                      DFLTGRP may also be coded as DGRP.             * 00002800
*                      PASSWORD may also be coded as PWD.             * 00002900
*                                                                     * 00003000
*        Return codes: 00 - all good.                                 * 00003100
*                      08 - an error occurred, user is notified       * 00003200
*                           with a message                            * 00003300
*                                                                     * 00003400
*---------------------------------------------------------------------* 00003500
ALTUSER  CSECT                                                          00003600
         SAVE  (14,12),,*                                               00003700
         LR    R12,R15                                                  00003800
         USING ALTUSER,R12             Base register                    00003900
         LR    R2,R1                   Save parm (CPPL)                 00004000
         GETMAIN RU,LV=WORKL           Obtain savearea + working strg.  00004100
         ST    R1,8(,R13)              Forward pointer                  00004200
         ST    R13,4(,R1)              Backward pointer                 00004300
         LR    R13,R1                  This is our save area            00004400
         USING WORKAREA,R13            Base working storage             00004500
         ST    R2,MYCPPL               Save our CPPL address            00004600
         MVC   RAKFUSER,MDLUSER             ... model DCBs              00004700
         XC    DAIR08,DAIR08           Clear IKJDAIR                    00004800
         XC    DAIR18,DAIR18                        ... blocks          00004900
         XC    ANSWER,ANSWER           Clear IKJPARS answer             00005000
         XC    PPL#LA,PPL#LA           Clear pointer to PPL             00005100
         MVC   MSG3,MSG3X              Move message to working storage  00005200
         MVC   MSG6,MSG6X              Move message to working storage  00005300
         MVI   SW,0                    Clear flags                      00005400
         MVI   STAR,X'5C'              Asterisk in STAR                 00005500
         LA    R0,DCBABEND             DCB abend exit                   00005600
         ST    R0,EXLST                Save JFCB in exit list           00005700
         MVI   EXLST,X'91'             DCB abend exit is last entry     00005800
         LA    R0,EXLST                Exit list (DCB abend exit)       00005900
         STCM  R0,B'0111',RAKFUSER+DCBEXLSA-IHADCB                      00006000
         USING PSA,R0                  Point to CVT                     00006100
         L     R2,PSAANEW              Load ASCB                        00006200
         L     R2,ASCBASXB-ASCB(R2)    Load ASXB                        00006300
         ICM   R2,15,ASXBSENV-ASXB(R2) Point to ACEE                    00006400
         BNZ   CONT1                   Yes: found                       00006500
         LA    R1,MSGY                 Msg: 'No ACEE found'             00006600
         LA    R0,L'MSGY               Length                           00006700
         BAL   R14,TPUT                Write the message on screen      00006800
         B     RC08                    End with RC=-08                  00006900
CONT1    TM    ACEEFLG1-ACEE(R2),ACEESPEC Do we have the SPECIAL attr   00007000
         BO    CONT2                                                    00007100
         LA    R1,MSGZ                 Msg: 'No SPECIAL attribute'      00007200
         LA    R0,L'MSGZ               Length                           00007300
         BAL   R14,TPUT                Write the message on screen      00007400
         B     RC08                    End with RC=-08                  00007500
CONT2    DS    0H                                                       00007600
*---------------------------------------------------------------------* 00007700
*        Parse parameters                                             * 00007800
*---------------------------------------------------------------------* 00007900
         GETMAIN RU,LV=PPL#L           Obtain a dynamic PPL workarea    00008000
         STM   R0,R1,PPL#LA            Save length and address of PPL   00008100
         L     R2,PPL#PTR              Get the address of the PPL       00008200
         USING PPL,R2                  Adress it                        00008300
         L     R1,MYCPPL               Get address of CPPL              00008400
         USING CPPL,R1                 Address it                       00008500
*---------------------------------------------------------------------* 00008600
*                                                                       00008700
*        Populate the Parse Parameter List (PPL) from the CPPL,         00008800
*        add the IKJPARMD list in the PPL and invoke IKJPARS            00008900
*                                                                       00009000
*---------------------------------------------------------------------* 00009100
*                                                                       00009200
         MVC   PPLUPT,CPPLUPT          Put in the UPT address from CPPL 00009300
         MVC   PPLECT,CPPLECT          Put in the ECT address from CPPL 00009400
         MVC   PPLCBUF,CPPLCBUF        Put in the command buffer addr.  00009500
*                                      From the CPPL                    00009600
         XC    ECB,ECB                 Clear Event control block        00009700
         L     R1,=A(ADDPCL)           Address of PCL                   00009800
         ST    R1,PPLPCL               Set in PPL                       00009900
         LA    R1,ANSWER               Answer area                      00010000
         ST    R1,PPLANS               Pointer into PPL                 00010100
         LA    R1,ECB                  Event control block              00010200
         ST    R1,PPLECB               Pointer into PPL                 00010300
         ST    R13,PPLUWA              User provide workarea            00010400
         CALLTSSR EP=IKJPARS,MF=(E,PPL)   Invoke parse                  00010500
         DROP  R1,R2                   CPPL and PPL                     00010600
         LTR   R15,R15                 Parse successfully processed?    00010700
         BZ    PARSEOK                 Yes: carry                       00010800
         LA    R0,L'MSG5               Length                           00010900
         LA    R1,MSG5                 Message                          00011000
         BAL   R14,TPUT                                                 00011100
         XC    ANSWER,ANSWER           Avoid IKJRLSA                    00011200
         B     RC08                    Return to TMP                    00011300
PARSEOK  DS    0H                                                       00011400
         L     R8,ANSWER               Pointer to PDL                   00011500
         USING ADDPRS,R8               mapped with IKJPARM              00011600
         MVC   USERID,=CL8' '          Initialize UserID                00011700
         LA    R3,UIDPDE               UserID PDE                       00011800
         USING UIDRET,R3               Base this PDE                    00011900
         L     R1,UIDPTR               Pointer to UserID                00012000
         LH    R2,UIDL                 Length                           00012100
         BCTR  R2,0                    -1 for EX                        00012200
         EX    R2,MVEUID               Move UserID                      00012300
         B     ENDUID                  Branch over EX                   00012400
MVEUID   MVC   USERID(0),0(R1)         << Executed >>                   00012500
ENDUID   DS    0H                                                       00012600
         DROP  R3                      Unbase UIDRET                    00012700
         MVC   WORKPASS+1(8),=CL8' '   Initialize Password              00012800
         LA    R3,PASSWPDE             Point to Password PDE            00012900
         USING PASSRET,R3              Base this PDE                    00013000
         TM    PASSFLG,$PWPRES         Is Password present?             00013100
         BNO   ENDPAS                  No: good, Yes: also good         00013200
         LH    R2,PASSL                Length of password               00013300
         STC   R2,WORKPASS             Save password length             00013400
         L     R1,PASSPTR              Password itsself                 00013500
         BCTR  R2,0                    Minus 1 for EX                   00013600
         EX    R2,MVEPAS               Move password                    00013700
         B     ENDPAS                  Branch over EX                   00013800
MVEPAS   MVC   WORKPASS+1(0),0(R1)     << Executed >>                   00013900
ENDPAS   DS    0H                                                       00014000
         DROP  R3                      Unbase PASSRET                   00014100
         MVC   DFLTGRP,=CL8' '         Initialize Default Group         00014200
         LA    R3,DGRPPDE              Point to Default Group PDE       00014300
         USING DFTGRET,R3              Base this PDE                    00014400
         TM    DFTGFLG,$DFPRES         Is Default Group present?        00014500
         BNO   ENDDGRP                 No: not required, Yes: good      00014600
         LH    R2,DFTGL                Length of Default Group          00014700
         L     R1,DFTGPTR              Group name                       00014800
         BCTR  R2,0                    Minus 1 for EX                   00014900
         EX    R2,MVEDGRP              Move Group name                  00015000
         B     ENDDGRP                 Branch over EX                   00015100
MVEDGRP  MVC   DFLTGRP(0),0(R1)        << Executed >>                   00015200
ENDDGRP  DS    0H                                                       00015300
         DROP  R3                      Unbase DFTGRET                   00015400
         MVI   OPER,C' '               Default no operations            00015500
         CLI   OPERKW+1,1              Operations?                      00015600
         BNE   OPR01                   No: good, Yes: also good         00015700
         MVI   OPER,C'Y'               Set operations                   00015800
         B     SPEC01                  Finished                         00015900
OPR01    CLI   OPERKW+1,2              NOOPERATIONS                     00016000
         BNE   SPEC01                  NO: nothing to change            00016100
         MVI   OPER,C'N'               Set NOOPERATIONS                 00016200
SPEC01   DS    0H                                                       00016300
         MVI   SPECIAL,C' '            Default no SPECIAL               00016400
         CLI   SPECKW+1,1              SPECIAL?                         00016500
         BNE   SPEC03                  No: good, Yes: also good         00016600
         MVI   SPECIAL,C'Y'            Set SPECIAL                      00016700
         B     ENDPARS                 Finished                         00016800
SPEC03   CLI   SPECKW+1,2              NOSPECIAL?                       00016900
         BNE   ENDPARS                 NO: nothing to change            00017000
         MVI   SPECIAL,C'N'            Set NOSPECIAL                    00017100
ENDPARS  DS    0H                                                       00017200
*---------------------------------------------------------------------* 00017300
*        Allocate SYS1.SECURE.CNTL(USERS)                             * 00017400
*---------------------------------------------------------------------* 00017500
         LA    R3,DAIR08               Allocation request block         00017600
         USING DAPB08,R3               Base DAPB08                      00017700
         MVI   DA08CD+1,X'08'          Entry code 08 (allocation)       00017800
         MVC   DA08DDN,=CL8'RAKFUSER'  DDNAME to allocate               00017900
         MVC   DA08PDSN,=A(USRDSNL)    Temporary data set name          00018000
         MVI   DA08DSP1,DA08OLD        DISP=OLD                         00018100
         MVC   DA08MNM,=CL8'USERS'     Fixed member name                00018200
         MVI   DA08UNIT,C' '           Clear unit name                  00018300
         MVC   DA08UNIT+1(L'DA08UNIT-1),DA08UNIT                        00018400
         MVI   DA08SER,C' '            Clear volume serial              00018500
         MVC   DA08SER+1(L'DA08SER-1),DA08UNIT                          00018600
         LR    R1,R3                   Parameter CALLTS                 00018700
         BAL   R14,CALLTS              IKJDAIR routine                  00018800
         LTR   R15,R15                 Allocation OK?                   00018900
         BZ    ALTU003                 Yes: carry on                    00019000
         LA    R1,MSG1                 Msg: 'allocation error USER'     00019100
         LA    R0,L'MSG1               Length                           00019200
         BAL   R14,TPUT                Write the message on screen      00019300
         B     RC08                    Return code 8                    00019400
         DROP  R3                      Unbase DABP08                    00019500
ALTU003  DS    0H                                                       00019600
*---------------------------------------------------------------------* 00019700
*        Open SYS1.SECURE.CNTL(USERS) with DDNAME RAKUSER             * 00019800
*---------------------------------------------------------------------* 00019900
         MVI   OPEND,X'80'             First and only DCB               00020000
         OPEN  (RAKFUSER,(UPDAT)),MF=(E,OPEND)                          00020100
         TM    SW,$913                 Access denied?                   00020200
         BNO   ALTU007                 No: assumed, that open is succes 00020300
         MVC   MSG3+9(8),=CL8'RAKFUSER'  DD-name                        00020400
         LA    R1,MSG3                 Msg: 'xxxxxxxx access denied'    00020500
         LA    R0,L'MSG3               Length                           00020600
         BAL   R14,TPUT                Write the message on screen      00020700
         BAL   R14,FREE                Free the data sets               00020800
         B     RC08                    Return code 8                    00020900
         B     RC08                    Return code 8                    00021000
ALTU007  DS    0H                                                       00021100
         NI    SW,255-$OSCHG-$DFTUPD-$PWUPD Set update flags off        00021200
*---------------------------------------------------------------------* 00021300
*        Read the USERS records and check if OPERATIONS and/or        * 00021400
*        SPECIAL and/or PASSWORD is changed.                          * 00021500
*        Update the record is a match is found.                       * 00021600
*---------------------------------------------------------------------* 00021700
ALTU009  DS    0H                                                       00021800
         GET   RAKFUSER                Read a record                    00021900
         LR    R3,R1                   Save address of record           00022000
         USING USERREC,R3              Base of USERREC                  00022100
         CLC   USERUID,USERID          Match found of UserID?           00022200
         BNE   ALTU009                 No: read next record             00022300
         CLI   OPER,C' '               OPERATIONS specified?            00022400
         BE    ALTU011                 No: carry on                     00022500
         MVC   USEROPR,OPER            Move changed OPERATIONS          00022600
         OI    SW,$OSCHG               Mark SPEC and/or OPER changed    00022700
ALTU011  CLI   SPECIAL,C' '            SPECIAL specified?               00022800
         BE    ALTU013                 No: carry on                     00022900
         MVC   USERSPE,SPECIAL         Move changed SPECIAL             00023000
         OI    SW,$OSCHG               Mark SPEC and/or OPER changed    00023100
ALTU013  DS    0H                                                       00023200
         CLC   WORKPASS+1(8),=CL8' '   Password specified?              00023300
         BE    ALTU015                 No:                              00023400
*---------------------------------------------------------------------* 00023500
*        Initialize the Salt with the TOD clock and call RAKFPWH      * 00023600
*---------------------------------------------------------------------* 00023700
         STCK  SALT                    Salt = the TOD clock             00023800
         LA    R0,SALT                 Salt                             00023900
         ST    R0,HWPL+0               In parmlist                      00024000
         LA    R0,WORKPASS+1                                            00024100
         ST    R0,HWPL+4               In parmlist                      00024200
         XR    R1,R1                   Clear register                   00024300
         IC    R1,WORKPASS             Gotten password length           00024400
         ST    R1,HWPWLEN              Save in RAKFPWH list             00024500
         LA    R0,HWPWLEN                                               00024600
         ST    R0,HWPL+8               In parmlist                      00024700
         LA    R0,OUTPUT               Output field                     00024800
         ST    R0,HWPL+12              In parmlist                      00024900
         LA    R0,HWWORK               Work area                        00025000
         ST    R0,HWPL+16              In parmlist                      00025100
         LA    R1,HWPL                 Parmlist                         00025200
         ST    R13,HWR13               Save our area address            00025300
         LR    R4,R13                  Save our area address            00025400
         LA    R13,HWSAVE                                               00025500
         L     R15,=V(RAKFPWH)         Hashing routine                  00025600
         BALR  R14,R15                 Encrypt                          00025700
         LR    R13,R4                  Restore our area address         00025800
*---------------------------------------------------------------------* 00025900
*        Add the salt + hashed password in the USERS table.           * 00026000
*---------------------------------------------------------------------* 00026100
         MVC   USERSALT,SALT           Salt                             00026200
         MVC   USERHASH,OUTPUT         Hash                             00026300
         OI    SW,$PWUPD               Mark password updated            00026400
ALTU015  TM    SW,$PWUPD+$OSCHG        Password/operations/special chg? 00026500
         BZ    ALTU016                 No: check if DFLTGRP changed     00026600
         PUTX  RAKFUSER                                                 00026700
*---------------------------------------------------------------------* 00026800
*        Check if the DFLTGRP is changed. If so, write the record     * 00026900
*        with the new DFLTGRP.                                        * 00027000
*---------------------------------------------------------------------* 00027100
ALTU016  CLC   DFLTGRP,=CL8' '         Default group specified?         00027200
         BE    ALTU027                 No: we are finished              00027300
         BAL   R14,CLOSE               Close                            00027400
         MVI   OPEND,X'80'             First and only DCB               00027500
         OPEN  (RAKFUSER,(UPDAT)),MF=(E,OPEND) re-open                  00027600
ALTU018  GET   RAKFUSER                Read a record                    00027700
         LR    R3,R1                   Address of record                00027800
         CLC   USERUID,USERID          Userid matched?                  00027900
         BNE   ALTU018                 No: read next record             00028000
         CLC   USERGRP,DFLTGRP         This entry contains new DFLTGRP? 00028100
         BNE   ALTU018                 No: read next record             00028200
         MVC   USERDFT,STAR            Make this the DFLTGRP            00028300
         PUTX  RAKFUSER                Yes: update USER record          00028400
         OI    SW,$DFTUPD              Flag DFLTGRP updated             00028500
USEREOF  TM    SW,$DFTUPD              DFLTGRP  changed?                00028600
         BZ    ALTU027                 No: we are finished              00028700
         BAL   R14,CLOSE               Close                            00028800
         MVC   RAKFUSER+DCBEODA-IHADCB(3),=AL3(USEREOF2)                00028900
         MVI   OPEND,X'80'             First and only DCB               00029000
         OPEN  (RAKFUSER,(UPDAT)),MF=(E,OPEND) re-open                  00029100
*---------------------------------------------------------------------* 00029200
*        Disable the DFLTGRP of other GROUPS, with other words:       * 00029300
*        remove the star of the GROUPS, that are not the DFLTGRP.     * 00029400
*---------------------------------------------------------------------* 00029500
ALTU025  DS    0H                                                       00029600
         GET   RAKFUSER                Read a record                    00029700
         LR    R3,R1                   Address of record                00029800
         CLC   USERUID,USERID          Match found of UserID            00029900
         BNE   ALTU025                 No: read next record             00030000
         CLC   USERGRP,DFLTGRP         Is this the Default group?       00030100
         BE    ALTU025                 Yes: does already have a star    00030200
         CLC   USERDFT,STAR            Was this the default group?      00030300
         BNE   ALTU025                 No.                              00030400
         MVI   USERDFT,C' '            Remove star if there             00030500
         PUTX  RAKFUSER                Write record back                00030600
         B     ALTU025                 Check remaining groups           00030700
         DROP  R3                      Unbase USERREC                   00030800
*---------------------------------------------------------------------* 00030900
*        Close the data sets and return to TSO TMP                    * 00031000
*---------------------------------------------------------------------* 00031100
USEREOF2 DS    0H                                                       00031200
ALTU027  DS    0H                                                       00031300
         BAL   R14,CLOSE               Close the data sets              00031400
         BAL   R14,FREE                And unallocate                   00031500
         LA    R15,0                   RC = 0                           00031600
         B     RETURN                                                   00031700
*---------------------------------------------------------------------* 00031800
*        Return to TSO TMP.                                           * 00031900
*---------------------------------------------------------------------* 00032000
RC08     DS    0H                                                       00032100
         LA    R15,8                   RC = 8                           00032200
RETURN   DS    0H                                                       00032300
         LR    R4,R15                  Save return code                 00032400
         ICM   R2,15,PPL#LA            Is PPL allocated?                00032500
         BZ    RETURN1                 No: do not free                  00032600
         LM    R2,R3,PPL#LA            Address + Length PPL             00032700
         FREEMAIN RU,LV=(2),A=(3)      Free the PPL                     00032800
RETURN1  TM    SW,$PWUPD+$DFTUPD+$OSCHG Anything changed?               00032900
         BNZ   RETURN2                 Yes: carry on                    00033000
         LA    R1,MSG4                 Msg: 'nothing altered'           00033100
         LA    R0,L'MSG4               Length                           00033200
         BAL   R14,TPUT                Write message on screen          00033300
         B     RETURN8                 And branch                       00033400
RETURN2  DS    0H                                                       00033500
         MVC   MSG6+14(8),USERID       UserID in message                00033600
         LA    R1,MSG6                 Msg: 'successfully altered'      00033700
         LA    R0,L'MSG6               Length                           00033800
         BAL   R14,TPUT                Write message on screen          00033900
         LA    R1,MSGA                 Msg: 'run RAKFUSER ...'          00034000
         LA    R0,L'MSGA               Length                           00034100
         BAL   R14,TPUT                Write message on screen          00034200
RETURN8  DS    0H                                                       00034300
         ICM   R8,15,ANSWER            Pointer to PDE's (the PDL)       00034400
         BZ    RETURN9                 No: skip                         00034500
         IKJRLSA (R8)                  Release PARSE storage            00034600
RETURN9  LR    R3,R13                  Load working storage to free     00034700
         L     R13,4(,R13)             Load caller's save area          00034800
         FREEMAIN RU,LV=WORKL,A=(3)    Release working storage          00034900
         LR    R15,R4                  Restore return code              00035000
         RETURN (14,12),RC=(15)        Return                           00035100
*                                                                       00035200
         TITLE 'Invoke IKJDAIR, A(Parm block) in R1'                    00035300
*---------------------------------------------------------------------* 00035400
*        Routine:   CALLTS                                            * 00035500
*        Function:  Invoke IKJDAIR to allocate or unallocate data sets* 00035600
*                   Register 1 contains the address of the allocation * 00035700
*                   or unallocation DAIR parameter blocks.            * 00035800
*---------------------------------------------------------------------* 00035900
CALLTS   DS    0H                                                       00036000
         ST    R14,R14TS               Save register 14                 00036100
         LR    R14,R1                  Save A(IKJDAIR parm block)       00036200
         XC    ECB,ECB                 Clear ECB                        00036300
         LA    R1,DAIRDAPL                                              00036400
         L     R2,MYCPPL               Pickup our CPPL                  00036500
         USING CPPL,R2                 Base CPPL                        00036600
         USING DAPL,R1                 Base IKJDAPL                     00036700
         MVC   DAPLUPT(4),CPPLUPT                                       00036800
         MVC   DAPLECT(4),CPPLECT                                       00036900
         XC    ECB,ECB                 Clear Event control block        00037000
         LA    R0,ECB                  Address of our ECB               00037100
         ST    R0,DAPLECB              Set A(ECB) in DAPL               00037200
         MVC   DAPLPSCB(4),CPPLPSCB                                     00037300
         ST    R14,DAPLDAPB            Set A(parm block) in DAPL        00037400
         CALLTSSR EP=IKJDAIR,MF=(E,DAIRDAPL)                            00037500
         L     R14,R14TS               Restore register 14              00037600
         BR    R14                                                      00037700
         DROP  R1,R2                   Unbase DAPL and CPPL             00037800
         TITLE 'Write message on screen'                                00037900
*---------------------------------------------------------------------* 00038000
*        Write the message on the terminal with a PUTLINE.            * 00038100
*        Register 0 = the length of the message.                      * 00038200
*        Register 1 = adress of the message.                          * 00038300
*---------------------------------------------------------------------* 00038400
TPUT     DS    0H                                                       00038500
         ST    R14,R14TPUT             Save register 14                 00038600
         L     R3,MYCPPL               Pickup CPPL of this command      00038700
         USING CPPL,R3                 Base IKJCPPL                     00038800
         MVI   PUTLINE+4,C' '          Clear output line                00038900
         MVC   PUTLINE+5(79),PUTLINE+4         ,,                       00039000
         LR    R2,R0                   Length of message                00039100
         BCTR  R2,0                    Minus 1 for EX                   00039200
         EX    R2,MVEMSG               Move the message                 00039300
         LA    R2,5(,R2)               Length in including length field 00039400
         XC    PUTLINE+2(2),PUTLINE+2  Byte 2 and 3, reserved           00039500
         STCM  R2,B'0011',PUTLINE      Save length in byte 0 and 1      00039600
         L     R2,CPPLUPT              User Profile Table               00039700
         L     R3,CPPLECT              Environment Control Table        00039800
         XC    ECB,ECB                 Force PUTLINE to wait            00039900
         LA    R0,PUTLINE              Data line address                00040000
         PUTLINE PARM=PUTBLOK,,MF=(E,PUTIOPL),                         *00040100
               OUTPUT=((0),TERM,SINGLE,DATA),ECB=ECB,UPT=(2),ECT=(3),  *00040200
               TERMPUT=(EDIT,WAIT,NOHOLD,NOBREAK)                       00040300
         L     R14,R14TPUT             Restore register 14              00040400
         BR    R14                                                      00040500
MVEMSG   MVC   PUTLINE+4(0),0(R1)      << executed >>                   00040600
         DROP  R3                      Unbase CPPL                      00040700
         TITLE 'Free SYS1.SECURE.CNTL'                                  00040800
FREE     DS    0H                                                       00040900
         ST    R14,R14FREE             Save register 14                 00041000
         LA    R3,DAIR18               Point to unallocation parm block 00041100
         XC    DAIR18,DAIR18           Clear unallocation parm block    00041200
         USING DAPB18,R3               IKJDAP18                         00041300
         MVI   DA18CD+1,X'18'          Entry code 0018 (unallocate)     00041400
         MVI   DA18MNM,C' '            Provide no ...                   00041500
         MVC   DA18MNM+1(7),DA18MNM               member name           00041600
         MVC   DA18DDN,=CL8'RAKFUSER'  DDNAME to unallocate             00041700
         LR    R1,R3                   Parameter CALLTS                 00041800
         BAL   R14,CALLTS              IKJDAIR routine                  00041900
         L     R14,R14FREE             Restore register 14              00042000
         BR    R14                     Return                           00042100
         DROP  R3                      Unbase DAPB18                    00042200
         TITLE 'Close RAKFUSER'                                         00042300
CLOSE    ST    R14,R14CLOSE            Save register 14                 00042400
         MVI   CLOSED,X'80'            First and only DCB               00042500
         CLOSE RAKFUSER,MF=(E,CLOSED)                                   00042600
         L     R14,R14CLOSE            Restore register 14              00042700
         BR    R14                     Return                           00042800
         TITLE 'DCB abend exit'                                         00042900
DCBABEND DS    0H                                                       00043000
         TM    3(R1),B'00001110'       Processing allowed?              00043100
         BZR   R14                     No: continue with abend          00043200
         TM    3(R1),4                 Ignore bit on?                   00043300
         MVI   3(R1),0                 Prepare for NO                   00043400
         BZR   R14                                                      00043500
         MVC   DCBCOMP,0(R1)           Move completion code             00043600
         NC    DCBCOMP,=X'FFF0'        Clear last nibble                00043700
         CLC   DCBCOMP,=X'9130'        Do we have an RACF/ACF2 abend?   00043800
         BNER  R14                     No: continue with abend          00043900
         MVI   3(R1),4                 Yes: ignore abend                00044000
         OI    SW,$913                 Indicate 913 abend               00044100
         BR    R14                     Return to Access Method          00044200
PCLSTART DS    0H                                                       00044300
ADDPCL   IKJPARM DSECT=ADDPRS          PDE's                            00044400
UIDPDE   IKJPOSIT JOBNAME,PROMPT='RAKF UserID',                        *00044500
               HELP=('a valid UserID')                                  00044600
PASSWKW  IKJKEYWD                                                       00044700
         IKJNAME 'PASSWORD',SUBFLD=PASSWSF,ALIAS='PWD'                  00044800
DFTGRPKW IKJKEYWD                                                       00044900
         IKJNAME 'DFLTGRP',SUBFLD=DGRPSF,ALIAS='DGRP'                   00045000
OPERKW   IKJKEYWD                                                       00045100
         IKJNAME 'OPERATIONS'                                           00045200
         IKJNAME 'NOOPERATIONS'                                         00045300
SPECKW   IKJKEYWD                                                       00045400
         IKJNAME 'SPECIAL'                                              00045500
         IKJNAME 'NOSPECIAL'                                            00045600
PASSWSF  IKJSUBF                                                        00045700
PASSWPDE IKJIDENT 'Password',                                          *00045800
               FIRST=ALPHANUM,OTHER=ALPHANUM,MAXLNTH=8,                *00045900
               PROMPT='Enter a valid password',VALIDCK=PWCHK,          *00046000
               HELP='a password with at least 4 characters'             00046100
DGRPSF   IKJSUBF                                                        00046200
DGRPPDE  IKJIDENT 'Default group',                                     *00046300
               FIRST=ALPHA,OTHER=ALPHANUM,MAXLNTH=8,                   *00046400
               PROMPT='a default RAKF group'                            00046500
         IKJENDP                                                        00046600
PCL#L    EQU   *-PCLSTART                                               00046700
         TITLE 'CONSTANTS'                                              00046800
MDLUSER  DCB   DSORG=PS,LRECL=80,DDNAME=RAKFUSER,EODAD=USEREOF,        *00046900
               MACRF=(GL,PL)                                            00047000
MDLULEN  EQU   *-MDLUSER                                                00047100
*                                                                       00047200
USRDSNL  DC    AL2(L'USRDSN)                                            00047300
USRDSN   DC    C'SYS1.SECURE.CNTL'     RAKF control data set            00047400
*                                                                       00047500
MSG1     DC    C'SYS1.SECURE.CNTL(USERS) could not be allocated'        00047600
MSG3X    DC    C'ALTUSER: xxxxxxxx access denied'  +9                   00047700
MSG4     DC    C'ALTUSER: Nothing altered'                              00047800
MSG5     DC    C'ALTUSER: Parse error'                                  00047900
MSG6X    DC    C'ALTUSER: User xxxxxxxx successfully altered' +14       00048000
MSGA     DC    C'ALTUSER: Run RAKFUSER to activate the changes'         00048100
MSGY     DC    C'ALTUSER: No ACEE found'                                00048200
MSGZ     DC    C'ALTUSER: Not authorized, no SPECIAL attribute'         00048300
         LTORG ,                                                        00048400
         DROP                                                           00048500
*---------------------------------------------------------------------* 00048600
*        Validate Presence of the Password                            * 00048700
*---------------------------------------------------------------------* 00048800
PWCHK    DS    0H                                                       00048900
         STM   R14,R12,12(R13)         Save registers                   00049000
         LR    R12,R15                 Load base register               00049100
         USING PWCHK,R12                                                00049200
         L     R3,0(,R1)               Point to PASSWORD PDE            00049300
         USING PASSRET,R3              Address it                       00049400
         SR    R15,R15                 Default return code 0            00049500
         TM    PASSFLG,$PWPRES         Was keyword present?             00049600
         BNZ   PW02                    Yes: good                        00049700
         LA    R15,4                   Return code 4                    00049800
         B     PWEXIT                  Return                           00049900
PW02     DS    0H                                                       00050000
         LH    R1,PASSL                Length                           00050100
         CH    R1,=H'3'                At least 4 bytes long            00050200
         BH    PWEXIT                  Yes: good                        00050300
         LA    R15,4                   Return code 4                    00050400
PWEXIT   L     R14,12(,R13)            Restore register 14              00050500
         LM    R0,R12,20(R13)          Restore other registers          00050600
         BR    R14                     Return to caller                 00050700
         DROP  R3,R12                  Unbase PASSRET and PWCHK         00050800
         LTORG ,                                                        00050900
*                                                                       00051000
UIDRET   DSECT                         PDE of UserID                    00051100
UIDPTR   DS    F                       Pointer to UserID                00051200
UIDL     DS    H                       Length of UserID                 00051300
UIDFLG   DS    C                                                        00051400
$UPRES   EQU   128                     Group(s) are present             00051500
         DS    C                       Reserved                         00051600
*                                                                       00051700
PASSRET  DSECT                         PDE of Password                  00051800
PASSPTR  DS    F                       Pointer to Password              00051900
PASSL    DS    H                       Length of Password               00052000
PASSFLG  DS    C                                                        00052100
$PWPRES  EQU   128                     Password is present              00052200
         DS    C                       Reserved                         00052300
*                                                                       00052400
DFTGRET  DSECT                         PDE of Default GROUP             00052500
DFTGPTR  DS    F                       Pointer to default group         00052600
DFTGL    DS    H                       Length of group                  00052700
DFTGFLG  DS    C                                                        00052800
$DFPRES  EQU   128                     Default group is present         00052900
         DS    C                       Reserved                         00053000
*                                                                       00053100
USERREC  DSECT                         User record                      00053200
USERTYP  DS    0CL9                    UserId + record type (1 or 2)    00053300
USERUID  DS    CL8                     Contains UserID                  00053400
USER#    DS    C                       Contains 1 or 2                  00053500
*                                      1 = user record 2 = connected gr 00053600
USERGRP  DS    CL8                     Group                            00053700
USERDFT  DS    C                       Contains a star if DFLTGRP       00053800
USERPWD  DS    CL8                     Password is blanked out          00053900
         DS    C                                                        00054000
USEROPR  DS    C             Operations / Nooperations (if USER# = 1)   00054100
         DS    C                                                        00054200
USERSPE  DS    C             Special / Nospecial (only if USER# =1)     00054300
         DS    C                                                        00054400
USERSALT DS    CL8                     Salt (only if USER# = 1)         00054500
USERHASH DS    CL32                 Hashed password (only if USER# = 1) 00054600
*                                                                       00054700
WORKAREA DSECT                         Working storage                  00054800
         DS    18F                     Our save area                    00054900
MYCPPL   DS    F                                                        00055000
DAIRDAPL DS    5F                      DAIR parameter list              00055100
ECB      DS    F                       For IKJDAIR                      00055200
R14CLOSE DS    F                       Register 14 CLOSE                00055300
R14FREE  DS    F                       Register 14 FREE                 00055400
R14TPUT  DS    F                       Register 14 TPUT                 00055500
R14TS    DS    F                       Register 14 CALLTS               00055600
EXLST    DS    F                       DCB abend exit                   00055700
OPEND    DS    F                       OPEN MF=L                        00055800
CLOSED   DS    F                       CLOSE MF=L                       00055900
ANSWER   DS    F                       Parse answer area                00056000
PUTIOPL  DS    4F                      IKJIOPL                          00056100
PUTBLOK  PUTLINE MF=L                  PUTLINE PTPB                     00056200
